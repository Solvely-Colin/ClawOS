#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=../config/versions.env
source "$repo_root/image/config/versions.env"
mode="release"
case "${1:-}" in
  ""|--release) mode="release" ;;
  --fast) mode="fast" ;;
  -h|--help)
    echo "Usage: sudo $0 [--fast|--release]"
    exit 0
    ;;
  *)
    echo "Unknown build mode: $1" >&2
    echo "Usage: sudo $0 [--fast|--release]" >&2
    exit 2
    ;;
esac

# Large mkarchiso work trees default to host-local /var/tmp. Persistent VM
# builders may place them on a dedicated volume, but only through an existing,
# canonical directory so cleanup can never escape the reviewed work basename.
work_root=${CLAWOS_BUILD_WORK_ROOT:-/var/tmp}
if [[ "$work_root" != /* || ! -d "$work_root" || -L "$work_root" ||
      "$(realpath -e -- "$work_root")" != "$work_root" ]]; then
  echo 'CLAWOS_BUILD_WORK_ROOT must be an existing canonical absolute directory, not a symlink.' >&2
  exit 2
fi

if [[ "$mode" == fast ]]; then
  profile="$repo_root/artifacts/m1/profile-fast"
  work="$work_root/clawos-m1-work-fast"
  out="$repo_root/artifacts/m1/out-fast"
else
  profile="$repo_root/artifacts/m1/profile"
  work="$work_root/clawos-m1-work"
  out="$repo_root/artifacts/m1/out"
fi
# Keep mkarchiso's bind-mounted proc/sys/dev tree outside the desktop workspace.
# Codex and file indexers inspect workspace descendants, which can pin those
# mounts and make archiso cleanup fail even after a successful initramfs build.

if [[ $EUID -ne 0 ]]; then
  echo "Run as root: sudo $0" >&2
  exit 1
fi

# A materialized profile and mkarchiso work tree are build products. Reusing
# either can silently omit overlay changes, so every accepted image starts from
# the pinned source inputs. Preserve the previous ISO output for comparison and
# rollback; discard only reproducible profile/work intermediates.
if [[ -d "$out" ]]; then
  if [[ "$mode" == fast ]]; then
    # Fast images are disposable iteration artifacts. Retaining every one
    # would consume roughly 2 GiB per edit/build/test cycle.
    find "$out" -depth -delete
    echo "Removed previous disposable fast ISO output."
  else
    build_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archive="$repo_root/artifacts/m1/archive/$mode-build-$build_stamp"
    if [[ -e "$archive" ]]; then
      archive="$archive-$$"
    fi
    mkdir -p "$archive"
    mv "$out" "$archive/out"
    echo "Archived previous ISO output at $archive/out"
  fi
fi

# An interrupted mkarchiso/pacstrap run can leave proc, sys, dev, or run bound
# below the disposable work tree. Unmount only those generated submounts before
# deleting the work product; never traverse outside the resolved artifact path.
if [[ -d "$work" ]]; then
  mapfile -t work_mounts < <(findmnt -r -n -o TARGET)
  for ((mount_index=${#work_mounts[@]} - 1; mount_index >= 0; mount_index--)); do
    work_mount="${work_mounts[$mount_index]}"
    [[ "$work_mount" == "$work"/* ]] || continue
    umount "$work_mount" 2>/dev/null || umount --lazy "$work_mount"
  done
fi

for generated_dir in "$profile" "$work"; do
  if [[ -d "$generated_dir" ]]; then
    find "$generated_dir" -depth -delete
  fi
done

sudo -u "${SUDO_USER:-root}" "$repo_root/image/bin/materialize-profile" "$profile"

# Archive responses can stall under concurrent libalpm transfers, including in
# QEMU/WHPX. Apply this only to the generated build config, not the host's pacman
# settings or the installed target. Package signature policy stays unchanged.
sed -i -e 's/^ParallelDownloads[[:space:]]*=.*/ParallelDownloads = 1/' \
  -e '/^\[options\]/a DisableDownloadTimeout' "$profile/pacman.conf"

"$repo_root/image/tests/validate-profile.sh" "$profile"

# Ship the pinned runtime as an ISO build input. Target installation copies
# this clean package tree, never the builder's personal/global installation.
runtime_input=$(mktemp -d /var/tmp/clawos-openclaw-input.XXXXXX)
# Packing must not execute unverified lifecycle code. The root-owned temporary
# directory holds only this download; install reads the verified local tarball.
npm pack "openclaw@$OPENCLAW_VERSION" --ignore-scripts --json \
  --pack-destination "$runtime_input" >"$runtime_input/pack.json"
runtime_archive="$runtime_input/openclaw-$OPENCLAW_VERSION.tgz"
python3 "$repo_root/image/bin/verify-openclaw-archive" \
  "$runtime_archive" "$OPENCLAW_INTEGRITY" "$OPENCLAW_VERSION" "$OPENCLAW_COMMIT"
for attempt in 1 2 3; do
  if timeout --kill-after=10s 15m npm install --global \
    --prefix "$profile/airootfs/usr" --no-audit --no-fund \
      --allow-scripts="file:$runtime_archive,@google/genai,tree-sitter-bash,protobufjs" \
    "$runtime_archive"; then
    break
  fi
  (( attempt < 3 )) || { echo 'Pinned OpenClaw ISO preparation failed.' >&2; exit 1; }
  sleep 3
done
"$profile/airootfs/usr/bin/openclaw" --version | grep -Fq "$OPENCLAW_VERSION"
inventory_root="$profile/airootfs/usr/share/licenses/openclaw-npm"
inventory_work="$runtime_input/inventory-work"
python3 "$repo_root/image/bin/generate-openclaw-inventory" \
  "$profile/airootfs/usr/lib/node_modules/openclaw" "$inventory_root" \
  "$inventory_work/package-lock.json"
(
  cd "$inventory_work"
  npm sbom --package-lock-only --sbom-format cyclonedx --omit dev \
    >"$inventory_root/SBOM.cdx.json"
  audit_exit=0
  set +e
  timeout --kill-after=5s 2m npm audit --json --package-lock-only --omit dev \
    >"$inventory_root/AUDIT.json"
  audit_exit=$?
  set -e
  jq -e 'type == "object"' "$inventory_root/AUDIT.json" >/dev/null
  printf 'npm audit exit code: %s (non-zero vulnerability findings do not fail the build)\n' \
    "$audit_exit" >"$inventory_root/AUDIT-STATUS.txt"
)
jq -e '.bomFormat == "CycloneDX" and (.components | length > 0)' \
  "$inventory_root/SBOM.cdx.json" >/dev/null
python3 - "$inventory_root/manifest.json" "$inventory_root/SBOM.cdx.json" <<'PY'
import json, sys
with open(sys.argv[1]) as source:
    installed = json.load(source)['packages']
with open(sys.argv[2]) as source:
    components = json.load(source)['components']
installed_ids = {(item['name'], item['version']) for item in installed}
sbom_ids = {(item['name'], item['version']) for item in components}
if installed_ids != sbom_ids:
    raise SystemExit('CycloneDX components differ from the installed npm inventory')
PY
# ArchISO normalizes overlay file modes to 0644 unless explicitly listed.
# Preserve executable package entry points and native helpers, not just the
# top-level openclaw symlink. %q keeps package paths literal in profiledef.sh.
while IFS= read -r -d '' executable; do
  printf 'file_permissions[%q]="0:0:755"\n' "${executable#"$profile/airootfs"}" >>"$profile/profiledef.sh"
done < <(find "$profile/airootfs/usr/lib/node_modules/openclaw" -type f -perm /111 -print0)

if [[ "$mode" == fast ]]; then
  # Development images remain clean, validated ArchISO builds, but zstd cuts
  # the edit/build/boot loop substantially. Keep them visibly distinct from
  # the XZ-compressed release artifact and its evidence.
  sed -i \
    -e 's/^iso_name="clawos"$/iso_name="clawos-fast"/' \
    -e "s/^airootfs_image_tool_options=.*/airootfs_image_tool_options=('-comp' 'zstd' '-Xcompression-level' '3' '-b' '1M')/" \
    "$profile/profiledef.sh"
  grep -Fqx 'iso_name="clawos-fast"' "$profile/profiledef.sh"
  grep -Fqx "airootfs_image_tool_options=('-comp' 'zstd' '-Xcompression-level' '3' '-b' '1M')" "$profile/profiledef.sh"
  echo "Fast development mode: zstd level 3, isolated fast output."
fi
mkdir -p "$work" "$out"
mkarchiso -v -w "$work" -o "$out" "$profile"

iso="$(find "$out" -maxdepth 1 -type f -name '*.iso' -print -quit)"
test -n "$iso"
"$repo_root/image/tests/validate-iso.sh" "$iso"
cp "$inventory_root/SBOM.cdx.json" "$out/SBOM.cdx.json"
cp "$inventory_root/AUDIT.json" "$out/AUDIT.json"
cp "$inventory_root/AUDIT-STATUS.txt" "$out/AUDIT-STATUS.txt"
cp "$inventory_root/manifest.json" "$out/OPENCLAW-LICENSES.json"
(
  cd "$out"
  sha256sum "${iso##*/}" SBOM.cdx.json AUDIT.json AUDIT-STATUS.txt \
    OPENCLAW-LICENSES.json >SHA256SUMS
  sha256sum "${iso##*/}" >"${iso##*/}.sha256"
)
echo "Built $iso"
echo "Profile was freshly materialized from the pinned overlay for this build."
echo "Build mode: $mode"
