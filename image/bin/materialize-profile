#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=../config/versions.env
source "$repo_root/image/config/versions.env"
destination="${1:-$repo_root/artifacts/m1/profile}"
releng=/usr/share/archiso/configs/releng

if [[ ! -d "$releng" ]]; then
  echo "ArchISO releng profile missing. Run ./image/bin/install-build-deps first." >&2
  exit 1
fi

if [[ -e "$destination" ]]; then
  echo "Refusing to overwrite existing profile: $destination" >&2
  exit 1
fi

mkdir -p "$(dirname "$destination")"
cp -a "$releng" "$destination"
cp -a "$repo_root/image/profile-overlay/." "$destination/"
# Preflight imports runtime modules. Generated bytecode is not an image input,
# even when it is ignored by Git in the developer's source checkout.
find "$destination/airootfs" -type d -name __pycache__ -prune -exec rm -r -- {} +
find "$destination/airootfs" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
install -m 0644 "$repo_root/image/config/mirrorlist" \
  "$destination/airootfs/etc/pacman.d/mirrorlist"
install -m 0644 "$repo_root/image/config/versions.env" \
  "$destination/airootfs/etc/clawos/versions.env"
mkdir -p "$destination/airootfs/usr/lib/clawos/openclaw-plugin"
cp -a "$repo_root/integrations/openclaw/." \
  "$destination/airootfs/usr/lib/clawos/openclaw-plugin/"
rm -rf "$destination/airootfs/usr/lib/clawos/openclaw-plugin/node_modules"
mkdir -p \
  "$destination/airootfs/usr/lib/clawos/clawosd" \
  "$destination/airootfs/etc/dbus-1/system.d" \
  "$destination/airootfs/usr/share/dbus-1/system-services" \
  "$destination/airootfs/usr/share/dbus-1/interfaces" \
  "$destination/airootfs/usr/share/polkit-1/actions"
install -m 0644 "$repo_root/services/clawosd/src/clawosd_core.py" \
  "$destination/airootfs/usr/lib/clawos/clawosd/clawosd_core.py"
install -m 0755 "$repo_root/services/clawosd/src/clawosd_service.py" \
  "$destination/airootfs/usr/lib/clawos/clawosd/clawosd_service.py"
install -m 0755 "$repo_root/services/clawosd/src/clawosctl.py" \
  "$destination/airootfs/usr/lib/clawos/clawosctl"
install -m 0755 "$repo_root/services/clawosd/src/clawos_approval.py" \
  "$destination/airootfs/usr/lib/clawos/clawos-approval"
install -m 0644 "$repo_root/services/clawosd/config/clawosd.json" \
  "$destination/airootfs/etc/clawos/clawosd.json"
install -m 0644 "$repo_root/services/clawosd/systemd/clawosd.service" \
  "$destination/airootfs/etc/systemd/system/clawosd.service"
install -m 0644 "$repo_root/services/clawosd/dbus/org.clawos.System.conf" \
  "$destination/airootfs/etc/dbus-1/system.d/org.clawos.System.conf"
install -m 0644 "$repo_root/services/clawosd/dbus/org.clawos.System.service" \
  "$destination/airootfs/usr/share/dbus-1/system-services/org.clawos.System.service"
install -m 0644 "$repo_root/services/clawosd/dbus/org.clawos.System.xml" \
  "$destination/airootfs/usr/share/dbus-1/interfaces/org.clawos.System.xml"
install -m 0644 "$repo_root/services/clawosd/polkit/org.clawos.system.policy" \
  "$destination/airootfs/usr/share/polkit-1/actions/org.clawos.system.policy"

"$repo_root/image/tests/no-omarchy.sh" "$destination/airootfs"
echo "Materialized clean profile at $destination"
