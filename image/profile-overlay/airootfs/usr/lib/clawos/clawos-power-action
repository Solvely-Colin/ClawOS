#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  reboot)
    message='Restart ClawOS? Running processes will stop; saved files and agent state remain on disk.'
    label='Restart now'
    command='/usr/bin/systemctl reboot'
    ;;
  poweroff)
    message='Shut down ClawOS? Running processes will stop; saved files and agent state remain on disk.'
    label='Shut down'
    command='/usr/bin/systemctl poweroff'
    ;;
  *)
    exit 2
    ;;
esac

exec /usr/bin/swaynag \
  --type warning \
  --message "$message" \
  --button-dismiss-no-terminal "$label" "$command" \
  --dismiss-button 'Cancel' \
  --font 'Inter Variable 12' \
  --background 101312 \
  --border ff684f \
  --border-bottom ff684f \
  --text f3f1ee \
  --button-background 202121 \
  --button-text f3f1ee \
  --border-bottom-size 2 \
  --button-border-size 1 \
  --button-gap 8 \
  --button-padding 12
