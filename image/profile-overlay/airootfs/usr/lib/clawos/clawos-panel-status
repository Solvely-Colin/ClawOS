#!/usr/bin/env bash
set -euo pipefail

json() {
  /usr/bin/jq --compact-output --null-input \
    --arg text "$1" --arg tooltip "$2" --arg class "$3" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

case "${1:-}" in
  context)
    workspace="$(/usr/bin/swaymsg -t get_workspaces -r 2>/dev/null | \
      /usr/bin/jq -r '.[] | select(.focused) | .name' 2>/dev/null || true)"
    case "$workspace" in
      1:Main) json 'MAIN ACTIVITY' 'OpenClaw with attached machine surfaces' agent ;;
      *) json 'CLAWOS' 'Agent operating system' idle ;;
    esac
    ;;
  gateway)
    status="$(/usr/bin/timeout 5 /usr/lib/clawos/clawosctl status 2>/dev/null || true)"
    [[ -n "$status" ]] || status='{}'
    state="$(printf '%s' "$status" | /usr/bin/jq -r '.state // "unavailable"')"
    mode="$(printf '%s' "$status" | /usr/bin/jq -r '.mode // empty')"
    model="$(printf '%s' "$status" | /usr/bin/jq -r '.readiness.model // "unverified"')"
    case "$state" in
      setup-incomplete) json 'Setup required' 'Finish first-boot setup · click to return' setup-required ;;
      repair-required) json 'Repair required' 'A managed component needs recovery' offline ;;
      locked) json 'Session locked' 'Unlock this ClawOS session to continue' offline ;;
      startup) json 'Starting ClawOS' 'Desktop or Gateway is still connecting' idle ;;
      ready)
        [[ "$mode" == remote ]] && label='Controller online' || label='Gateway online'
        [[ "$model" == configured-unverified ]] && detail='Model configured · inference unverified' || detail='Model unverified'
        json "$label" "$detail" online
        ;;
      *) json 'State unavailable' 'The ClawOS state service is unavailable' offline ;;
    esac
    ;;
  *)
    json 'CLAWOS' 'Unknown panel status request' offline
    ;;
esac
