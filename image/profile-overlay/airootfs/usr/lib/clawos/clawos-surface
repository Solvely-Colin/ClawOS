#!/usr/bin/env bash
set -euo pipefail

surface="${1:-terminal}"
if [[ "$surface" != agent ]]; then
  export CLAWOS_SESSION_KEY="${2:-${CLAWOS_SESSION_KEY:-}}"
  CLAWOS_SESSION_KEY="$(/usr/bin/python3 /usr/lib/clawos/clawos_task.py)" || {
    /usr/bin/notify-send 'Choose a task' 'Ask the Agent in your conversation to open this surface first.'
    exit 1
  }
  export CLAWOS_SESSION_KEY
  CLAWOS_TASK_ID="$(printf '%s' "$CLAWOS_SESSION_KEY" | /usr/bin/sha256sum | /usr/bin/cut -c 1-24)"
  export CLAWOS_TASK_ID
fi

container_id() {
  local app_id="$1"
  /usr/bin/swaymsg -t get_tree -r 2>/dev/null | /usr/bin/jq -r \
    --arg app_id "$app_id" \
    '.. | objects | select(.app_id? == $app_id) | .id' | /usr/bin/head -n 1
}

fit_container() {
  local id="$1"
  local dimensions width height
  dimensions="$(/usr/bin/swaymsg -t get_workspaces -r 2>/dev/null | /usr/bin/jq -r \
    '.[] | select(.focused == true or .visible == true) | "\(.rect.width) \(.rect.height)"' | /usr/bin/head -n 1)"
  read -r width height <<<"$dimensions"
  [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || return 1
  /usr/bin/swaymsg "[con_id=\"$id\"] floating enable, resize set width $width px height $height px, move position 0 0, focus" >/dev/null 2>&1
}

focus_existing() {
  local app_id="$1"
  local id scratchpad_state
  id="$(container_id "$app_id")"
  [[ "$id" =~ ^[0-9]+$ ]] || return 1
  scratchpad_state="$(/usr/bin/swaymsg -t get_tree -r 2>/dev/null | /usr/bin/jq -r \
    --argjson id "$id" \
    '.. | objects | select(.id? == $id) | .scratchpad_state' | /usr/bin/head -n 1)"
  if [[ -n "$scratchpad_state" && "$scratchpad_state" != none ]]; then
    /usr/bin/swaymsg "[con_id=\"$id\"] scratchpad show" >/dev/null 2>&1
  fi
  fit_container "$id"
}

launch_once() {
  CLAWOS_SURFACE_ONCE=1 /usr/bin/setsid --fork "$@" >/dev/null 2>&1
}

launch_and_fit() {
  local app_id="$1"
  shift
  launch_once "$@"
  for _ in {1..50}; do
    if focus_existing "$app_id"; then
      return 0
    fi
    /usr/bin/sleep 0.1
  done
  return 1
}

case "$surface" in
  agent)
    /usr/lib/clawos/clawos-agent-panel close >/dev/null 2>&1 || true
    /usr/bin/swaymsg '[con_mark="^clawos-app-"] move scratchpad' >/dev/null 2>&1 || true
    /usr/bin/swaymsg '[app_id="^clawos-command(-|$)"] move scratchpad' >/dev/null 2>&1 || true
    /usr/bin/swaymsg '[app_id="^clawos-build(-|$)"] move scratchpad' >/dev/null 2>&1 || true
    /usr/bin/swaymsg '[app_id="^clawos-browse(-|$)"] move scratchpad' >/dev/null 2>&1 || true
    /usr/bin/swaymsg '[app_id="^clawos-conversation-"] move scratchpad' >/dev/null 2>&1 || true
    /usr/lib/clawos/clawos-agent-window focus >/dev/null
    ;;
  terminal)
    /usr/lib/clawos/clawos-agent-panel close >/dev/null 2>&1 || true
    focus_existing "clawos-command-$CLAWOS_TASK_ID" || launch_and_fit "clawos-command-$CLAWOS_TASK_ID" /usr/lib/clawos/clawos-command
    ;;
  build)
    /usr/lib/clawos/clawos-agent-panel close >/dev/null 2>&1 || true
    focus_existing "clawos-build-$CLAWOS_TASK_ID" || launch_and_fit "clawos-build-$CLAWOS_TASK_ID" /usr/lib/clawos/clawos-build
    ;;
  browser)
    /usr/lib/clawos/clawos-agent-panel close >/dev/null 2>&1 || true
    focus_existing "clawos-browse-$CLAWOS_TASK_ID" || launch_and_fit "clawos-browse-$CLAWOS_TASK_ID" /usr/lib/clawos/clawos-browse
    ;;
  *)
    printf 'Usage: clawos-surface {agent|terminal|build|browser}\n' >&2
    exit 2
    ;;
esac
