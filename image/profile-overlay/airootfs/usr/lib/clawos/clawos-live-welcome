            "do not identify who approves; local approval decisions and broker restrictions still apply. I accept the risk.",
            "body", 56))
        self.passwordless.get_accessible().set_name('Passwordless setup, empty passwords do not identify who approves, accept the risk')
        self.passwordless.connect('toggled', self._toggle_passwordless)
        right.pack_start(self.passwordless, False, False, 4)
        right.pack_start(self._label('Type ERASE- followed by the exact selected disk path to confirm installation.', 'warning', 58), False, False, 8)
        self.erase_confirmation = Gtk.Entry()
        self.erase_confirmation.set_placeholder_text('Select a disk first')
        self.erase_confirmation.get_accessible().set_name('Exact disk erase confirmation')
        self.erase_confirmation.connect('changed', self._validate_passphrase)
        right.pack_start(self.erase_confirmation, False, False, 0)
        self.install_button = self._button("Erase disk and install", "primary", self.start_install, "go-next-symbolic")
        self.install_button.set_sensitive(False)
        panes.pack_start(left, True, True, 0)
        panes.pack_start(right, True, True, 0)
        # The expanded warnings can exceed the viewport. Let the form scroll
        # while keeping Back/Erase reachable, including at 1440x900 and 1280x768.
        options = Gtk.ScrolledWindow()
        options.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        options.set_min_content_height(0)
        options.set_propagate_natural_height(False)
        options.get_accessible().set_name("Installation options")
        options.add(panes)
        content.pack_start(options, True, True, 0)
        actions = self._classes(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL), "install-actions")
        actions.set_homogeneous(True)
        back_slot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        back_slot.pack_start(self._button("Back", "quiet", self.show_welcome, "clawos-arrow-left"), False, False, 0)
        actions.pack_start(back_slot, True, True, 0)
        actions.pack_start(self.install_button, True, True, 0)
        content.pack_end(actions, False, False, 0)
        self.stage.pack_start(content, True, True, 0)
