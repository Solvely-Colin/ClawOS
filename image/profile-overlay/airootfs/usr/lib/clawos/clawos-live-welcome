        selector.grab_focus()

    def _select_disk(self, selector):
        if self.installing:
            return
        disk = self.disk_choices.get(selector.get_active_id())
        self.target = disk['path'] if disk else None
        self.disk_id = disk['diskId'] if disk else None
        if disk:
            self.disk_details.set_text(disk.get('label') or describe(disk))
        else:
            self.disk_details.set_text('No installation disk selected.')
        self.erase_confirmation.set_text('')
        self.erase_confirmation.set_placeholder_text(
            confirmation_token(self.target) if self.target else 'Select a disk first')
        self._validate_passphrase()

    def _passwordless_requested(self):
        return hasattr(self, "passwordless") and self.passwordless.get_active()

    def _toggle_passwordless(self, *_args):
        if self.installing:
            return
        passwordless = self._passwordless_requested()
        for entry in (self.password, self.confirm):
            entry.set_text("")
            entry.set_sensitive(not passwordless)
        if passwordless:
            self.passphrase_title.set_text("No passphrase")
            self.passphrase_help.set_text(
                "The disk is not encrypted, the screen never locks, and the root and clawos accounts "
                "have empty passwords. SSH refuses password login in every mode; use keys for remote access.")
            self.install_plan_label.set_text("No encryption  ·  Full Root (passwordless sudo)  ·  Recovery TTY on Ctrl+Alt+F3")
        else:
            self.passphrase_title.set_text("Disk unlock and session-lock passphrase")
            self.passphrase_help.set_text(
                "One passphrase unlocks the encrypted disk and is also the root and clawos account password; approval prompts on this machine ask for it. There is no second login.")
            self.install_plan_label.set_text("LUKS2 encryption  ·  Full Root (passwordless sudo)  ·  Recovery TTY on Ctrl+Alt+F3")
        self._validate_passphrase()

    def _passphrase_problem(self):
        """Return the passphrase error to show, or an empty string when acceptable."""
        if self._passwordless_requested():
            return ""
        secret = self.password.get_text()
        confirmation = self.confirm.get_text()
        if confirmation and secret != confirmation:
            return "The two passphrases do not match."
        if secret and len(secret) < 10:
            return "Use at least 10 characters for the disk passphrase."
        if not secret or not confirmation:
            return "incomplete"
        return ""

    def _validate_passphrase(self, *_args):
        if not hasattr(self, "install_button"):
            return
        problem = self._passphrase_problem()
        confirmed = bool(self.target) and self.erase_confirmation.get_text() == confirmation_token(self.target)
        self.install_button.set_sensitive(confirmed and not problem and not self.installing)
        self.error.set_text("" if problem == "incomplete" else problem)

    def start_install(self, *_args):
        if self.installing:
            return
        if not self.target or not self.disk_id or self.erase_confirmation.get_text() != confirmation_token(self.target):
            self.error.set_text('Select a disk and type its exact erase confirmation.')
            return
        passwordless = self._passwordless_requested()
        problem = self._passphrase_problem()
        if problem:
            self.error.set_text("Enter and repeat a passphrase of at least 10 characters." if problem == "incomplete" else problem)
            return
        self.installing = True
        selected_target, selected_disk_id = self.target, self.disk_id
        key_path = None
        if not passwordless:
            secret = self.password.get_text()
            key_path = pathlib.Path(os.environ["XDG_RUNTIME_DIR"]) / "clawos-install.key"
            try:
                fd = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            except FileExistsError:
                key_path.unlink()
                fd = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                os.write(fd, secret.encode("utf-8"))
            finally:
                os.close(fd)
        self.password.set_text("")
        self.confirm.set_text("")
        self._show_progress(passwordless)
        threading.Thread(
            target=self._run_installer,
            args=(key_path, selected_target, selected_disk_id, passwordless), daemon=True).start()

    def _show_progress(self, passwordless=False):
        self._clear()
        content = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28), "content")
        content.pack_start(self._screen_header(
            "INSTALLING CLAWOS",
            "Building the passwordless agent system…" if passwordless else "Building the encrypted agent system…",
            "Keep this machine powered on. Package installation can take several minutes."), False, False, 0)
        self.progress = Gtk.ProgressBar()
        GLib.timeout_add(250, self._pulse)
        content.pack_start(self.progress, False, False, 0)
        scroll = self._classes(Gtk.ScrolledWindow(), "log-frame")
        scroll.set_min_content_height(420)
        self.log = Gtk.TextView()
        self.log.set_editable(False)
        self.log.set_cursor_visible(False)
        scroll.add(self.log)
        content.pack_start(scroll, True, True, 0)
        content.pack_end(self._label("Recovery console · Ctrl + Alt + F3", "footer-text"), False, False, 0)
        self.stage.pack_start(content, True, True, 0)
        self.show_all()

    def _pulse(self):
        if not self.installing:
            return False
        self.progress.pulse()
        return True

    def _append_log(self, text):
        buffer = self.log.get_buffer()
        buffer.insert(buffer.get_end_iter(), text)
        mark = buffer.create_mark(None, buffer.get_end_iter(), False)
        self.log.scroll_mark_onscreen(mark)
        return False

    def _run_installer(self, key_path, target, disk_id, passwordless=False):
        disk_write_started = False
        command = [
            "/usr/bin/pkexec", "/usr/local/bin/clawos-install-dev",
            "--target", target, "--confirm", confirmation_token(target),
            "--disk-id", disk_id,
        ]
        if passwordless:
            command.append("--passwordless")
        else:
            command += ["--key-file", str(key_path)]
        try:
            process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in process.stdout:
                if line.strip() == 'CLAWOS_INSTALL_DISK_WRITE_STARTED':
                    disk_write_started = True
                GLib.idle_add(self._append_log, line)
            code = process.wait()
        except OSError as error:
            code = 127
            GLib.idle_add(self._append_log, f"Installer could not start: {error}\n")
        finally:
            if key_path is not None:
                try:
                    key_path.unlink()
                except FileNotFoundError:
                    pass
        GLib.idle_add(self._finish_install, code, passwordless, disk_write_started)

    def _finish_install(self, code, passwordless=False, disk_write_started=False):
        self.installing = False
        self._clear()
        content = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24), "content")
        if code == 0:
            if passwordless:
                lede = "Restart and remove the installation media. ClawOS boots straight into the agent workspace with no passphrase, no screen lock and empty account passwords."
                ready = "Passwordless agent system ready"
            else:
                lede = "Restart, remove the installation media, unlock the disk, and ClawOS will enter the agent workspace without a second login."
                ready = "Encrypted agent system ready"
            content.pack_start(self._screen_header("CLAWOS IS READY", "Installation complete.", lede), False, False, 0)
            content.pack_start(self._event_row(datetime.datetime.now().strftime("%H:%M:%S"), "installer", ready, True), False, False, 24)
            content.pack_start(self._button("Restart into ClawOS", "primary", self.reboot, "system-reboot-symbolic"), False, False, 0)
        else:
            content.pack_start(self._screen_header(
                "INSTALLATION PAUSED",
                "The target may be partially installed." if disk_write_started else "The target disk was not changed.",
                f"The installer stopped with code {code}. " +
                ("Do not treat this disk as bootable; inspect it from the recovery console." if disk_write_started else
                 "Check the network and retry. Disk protection checks will run again.") +
                " Recovery remains available on Ctrl + Alt + F3."), False, False, 0)
            content.pack_start(self._button("Return to installer", "quiet", self.show_install, "clawos-arrow-left"), False, False, 0)
        self.stage.pack_start(content, True, True, 0)
        self.show_all()
        return False

    @staticmethod
    def reboot(*_args):
        subprocess.Popen(["/usr/bin/pkexec", "/usr/lib/clawos/clawos-live-reboot"])


