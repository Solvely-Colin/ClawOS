class Welcome(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="ClawOS Setup")
        self.screen_width = self.get_screen().get_width()
        self.screen_height = self.get_screen().get_height()
        self.fullscreen()
        self.set_size_request(self.screen_width, self.screen_height)
        self.target = None
        self.installing = False
        self.current_view = "welcome"
        self.connect("key-press-event", self._on_key)
        self.get_accessible().set_name("ClawOS live setup")

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        overlay = Gtk.Overlay()
        overlay.add(self._background())
        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self._classes(self.root, "shell")
        overlay.add_overlay(self.root)
        self.add(overlay)
        self._topbar()
        self.stage = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self._classes(self.stage, "stage")
        self.root.pack_start(self.stage, True, True, 0)
        self.show_welcome()

    @staticmethod
    def _classes(widget, *names):
        context = widget.get_style_context()
        for name in names:
            context.add_class(name)
        return widget

    def _background(self):
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(THEME_ROOT / "background.png"))
            art_width = max(760, int(self.screen_width * 0.76))
            art_height = max(540, int(self.screen_height * 0.87))
            pixbuf = pixbuf.scale_simple(art_width, art_height, GdkPixbuf.InterpType.BILINEAR)
            canvas = Gtk.DrawingArea()
            canvas.set_size_request(self.screen_width, self.screen_height)

            def draw(_widget, context):
                Gdk.cairo_set_source_pixbuf(context, pixbuf, self.screen_width // 2, 0)
                context.paint_with_alpha(0.92)
                return False

            canvas.connect("draw", draw)
            return canvas
        except GLib.Error:
            return Gtk.Box()

    @staticmethod
    def _icon(name, size=Gtk.IconSize.MENU, style=None):
        if name == "clawos-arrow-left":
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    str(THEME_ROOT.parent / "icons" / "arrow-left.svg"), 15, 15, True
                )
                return Gtk.Image.new_from_pixbuf(pixbuf)
            except GLib.Error:
                name = "go-previous-symbolic"
        image = Gtk.Image.new_from_icon_name(name, size)
        if name == "media-record-symbolic":
            image.set_pixel_size(9)
        if style:
            image.get_style_context().add_class(style)
        return image

    @staticmethod
    def _pin():
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                str(THEME_ROOT / "clawos-pin.png"), 24, 24, True
            )
            return Gtk.Image.new_from_pixbuf(pixbuf)
        except GLib.Error:
            return Welcome._icon("computer-symbolic")

    def _topbar(self):
        top = self._classes(Gtk.Grid(), "topbar")
        top.set_column_homogeneous(True)
        brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        brand.pack_start(self._pin(), False, False, 0)
        brand.pack_start(self._label("ClawOS", "brand"), False, False, 0)
        state = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        state.pack_start(self._icon("media-record-symbolic", style="success"), False, False, 0)
        state.pack_start(self._label("Live environment", "top-state"), False, False, 0)
        system = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        system.pack_start(self._icon("network-wireless-signal-excellent-symbolic", style="muted"), False, False, 0)
        self.clock = self._label("", "top-time")
        system.pack_start(self.clock, False, False, 0)
        self._update_clock()
        GLib.timeout_add_seconds(30, self._update_clock)
        brand.set_halign(Gtk.Align.START)
        state.set_halign(Gtk.Align.CENTER)
        system.set_halign(Gtk.Align.END)
        top.attach(brand, 0, 0, 1, 1)
        top.attach(state, 1, 0, 1, 1)
        top.attach(system, 2, 0, 1, 1)
        self.root.pack_start(top, False, False, 0)

    def _update_clock(self):
        self.clock.set_text(datetime.datetime.now().strftime("%I:%M %p").lstrip("0"))
        return True

    def _clear(self):
        for child in self.stage.get_children():
            self.stage.remove(child)

    def _on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape and not self.installing and self.current_view != "welcome":
            self.show_welcome()
            return True
        return False

    @staticmethod
    def _label(text, style, width=None):
        label = Gtk.Label(label=text)
        label.get_style_context().add_class(style)
        label.set_xalign(0)
        label.set_line_wrap(True)
        if width:
            label.set_max_width_chars(width)
        return label

    def _button(self, text, style, callback, icon=None):
        button = Gtk.Button()
        self._classes(button, style)
        if style == "quiet":
            button.set_halign(Gtk.Align.START)
        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
        label_style = "button-primary-label" if style == "primary" else "body-strong"
        if icon == "clawos-arrow-left":
            content.pack_start(self._icon(icon), False, False, 0)
        content.pack_start(self._label(text, label_style), True, True, 0)
        if icon and icon != "clawos-arrow-left":
            content.pack_end(self._icon(icon), False, False, 0)
        button.add(content)
        button.connect("clicked", callback)
        return button

    def _hero(self):
        hero = self._classes(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL), "hero")
        hero.set_size_request(-1, min(478, max(390, self.screen_height - 422)))
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        copy.set_size_request(min(760, max(520, self.screen_width - 144)), -1)
        copy.set_valign(Gtk.Align.CENTER)
        copy.pack_start(self._label("Your machine,\nready to work with you.", "title", 24), False, False, 0)
        copy.pack_start(self._label(
            "ClawOS is an OpenClaw-native agent operating system.", "lede"), False, False, 0)
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=32)
        actions.set_margin_top(54)
        install = self._button("Install ClawOS", "primary", self.show_install, "go-next-symbolic")
        actions.pack_start(install, False, False, 0)
        actions.pack_start(self._button(
            "Inspect system", "secondary", self.show_try, "go-next-symbolic"), False, False, 0)
        copy.pack_start(actions, False, False, 0)
        hero.pack_start(copy, False, False, 0)
        install.grab_focus()
        return hero

    @staticmethod
    def _network_ready():
        # The live ISO runs archiso's systemd-networkd/iwd, the installed system
        # runs NetworkManager; a default route is the manager-agnostic signal.
        try:
            result = subprocess.run(
                ["ip", "-json", "route", "show", "default"], capture_output=True, text=True, timeout=3
            )
            return result.returncode == 0 and bool(json.loads(result.stdout or "[]"))
        except (OSError, subprocess.SubprocessError, ValueError):
            return False

    @staticmethod
    def _disks():
        return list_targets()

    def _disk_summary(self):
        try:
            disks = self._disks()
        except (OSError, subprocess.SubprocessError, ValueError):
            disks = []
        if not disks:
            return ("No eligible blank disk", "Unavailable")
        return (f"{len(disks)} eligible blank disk(s); selection required", "Available")

    def _fact_row(self, icon, label, value, state):
        row = self._classes(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12), "row")
        row.pack_start(self._icon(icon, style="muted"), False, False, 0)
        row.pack_start(self._label(label, "row-label"), False, False, 0)
        row.pack_end(self._label(state, "mono-success"), False, False, 0)
        value_label = self._label(value, "row-value")
        value_label.set_xalign(1)
        row.pack_end(value_label, True, True, 0)
        return row

    def _event_row(self, stamp, source, message, final=False):
        row = self._classes(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14), "event")
        row.pack_start(self._label(stamp, "mono"), False, False, 0)
        source_label = self._label(source, "mono")
        source_label.set_size_request(72, -1)
        row.pack_start(source_label, False, False, 0)
        row.pack_start(self._label(message, "mono-success" if final else "mono"), True, True, 0)
        row.pack_end(self._icon("media-record-symbolic", style="success"), False, False, 0)
        return row

    def _systems(self, compact=False):
        systems = self._classes(Gtk.Grid(), "systems")
        systems.set_column_homogeneous(True)
        systems.set_size_request(-1, min(294, max(250, self.screen_height // 3)))
        left = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "systems-left")
        right = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "systems-right")
        # Gtk 3 includes CSS padding in requested sizes. Derive the pane width
        # from the active output so the live UI also fits common VM displays.
        pane_width = -1 if compact else max(360, self.screen_width // 2 - 116)
        left.set_size_request(pane_width, -1)
        right.set_size_request(pane_width, -1)
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.pack_start(self._label("Live system", "section-label"), False, False, 0)
        header.pack_start(self._icon("media-record-symbolic", style="success"), False, False, 0)
        header.pack_start(self._label("Ready", "body"), False, False, 0)
        header.set_margin_bottom(10)
        left.pack_start(header, False, False, 0)
        disk, disk_state = self._disk_summary()
        left.pack_start(self._fact_row(
            "network-wireless-signal-excellent-symbolic", "Network", "ClawOS live", "Connected" if self._network_ready() else "Waiting"), False, False, 3)
        left.pack_start(self._fact_row(
            "video-display-symbolic", "Display",
            f"{self.screen_width} × {self.screen_height}", "60 Hz"), False, False, 0)
        left.pack_start(self._fact_row("drive-harddisk-symbolic", "Target disk", disk, disk_state), False, False, 0)
        left.pack_start(self._fact_row("changes-prevent-symbolic", "Recovery", "Ctrl + Alt + F3", "Available"), False, False, 0)
        right.pack_start(self._label("Live event stream", "section-label"), False, False, 0)
        now = datetime.datetime.now()
        stamps = [(now + datetime.timedelta(seconds=i)).strftime("%H:%M:%S") for i in range(7)]
        events = [
            ("systemd", "Starting ClawOS live environment…"),
            ("openclaw", "Agent runtime install staged"),
            ("netd", "Connected to ClawOS live"),
            ("displayd", f"Output active ({self.screen_width}×{self.screen_height}@60Hz)"),
            ("storaged", "Eligible installation disk detected" if disk_state != "Unavailable" else "Waiting for an eligible blank disk"),
            ("openclaw", "Capability policy staged"),
            ("systemd", "Live environment ready"),
        ]
        for index, (source, message) in enumerate(events):
            right.pack_start(self._event_row(stamps[index], source, message, final=index == len(events) - 1), False, False, 0)
        systems.attach(left, 0, 0, 1, 1)
        systems.attach(right, 1, 0, 1, 1)
        return systems

    def _footer(self):
        footer = self._classes(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL), "footer")
        footer.set_size_request(-1, 76)
        footer.pack_start(self._label("Recovery console · Ctrl + Alt + F3", "footer-text"), False, False, 0)
        return footer

    def show_welcome(self, *_args):
        if self.installing:
            return
        self.current_view = "welcome"
        self._clear()
        self.stage.pack_start(self._hero(), False, False, 0)
        self.stage.pack_start(self._systems(), False, False, 0)
        self.stage.pack_start(self._footer(), True, True, 0)
        self.show_all()

    def _screen_header(self, eyebrow, title, body):
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        header.pack_start(self._label(eyebrow, "eyebrow"), False, False, 0)
        header.pack_start(self._label(title, "screen-title", 36), False, False, 0)
        header.pack_start(self._label(body, "lede", 68), False, False, 0)
        return header

    def show_try(self, *_args):
        self.current_view = "inspect"
        self._clear()
        content = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=30), "content")
        content.pack_start(self._screen_header(
            "LIVE SYSTEM", "Inspect the machine before installing.",
            "Check network, display, target disk, and recovery. The full Agent workspace is created after installation."), False, False, 0)
        content.pack_start(self._systems(compact=True), False, False, 0)
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24)
        actions.set_hexpand(True)
        actions.set_halign(Gtk.Align.FILL)
        actions.pack_start(self._button("Back", "quiet", self.show_welcome, "clawos-arrow-left"), False, False, 0)
        actions.pack_start(Gtk.Box(), True, True, 0)
        install = self._button("Install ClawOS", "primary", self.show_install, "go-next-symbolic")
        install.set_halign(Gtk.Align.END)
        actions.pack_start(install, False, False, 0)
        content.pack_end(actions, False, False, 0)
        self.stage.pack_start(content, True, True, 0)
        self.show_all()

    def show_install(self, *_args):
        self.current_view = "install"
        self._clear()
        content = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14), "content")
        content.pack_start(self._screen_header(
            "INSTALL CLAWOS", "Create the agent system.",
            "Choose a blank disk for this experimental x86_64 UEFI installation. By default it is encrypted with LUKS2 and prepared for OpenClaw."), False, False, 0)
        panes = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        panes.set_homogeneous(True)
        left = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18), "content-pane-left")
        right = self._classes(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10), "content-pane-right")
        try:
            disks = self._disks()
        except (OSError, subprocess.SubprocessError, ValueError) as error:
            disks = []
            left.pack_start(self._label(f"Could not inspect disks: {error}", "danger"), False, False, 0)
        self.target = None
        self.disk_id = None
        self.disk_choices = {disk['path']: disk for disk in disks}
        selector = Gtk.ComboBoxText()
        self.disk_selector = selector
        self._classes(selector, 'target-selector')
        for renderer in selector.get_cells():
            renderer.set_property('ellipsize', Pango.EllipsizeMode.END)
            renderer.set_property('width-chars', 32)
        selector.get_accessible().set_name('Installation target disk')
        selector.append('', 'Select a blank disk — no default target')
        for disk in disks:
            selector.append(disk['path'], disk.get('label') or describe(disk))
        selector.set_active(0)
        selector.connect('changed', self._select_disk)
        left.pack_start(selector, False, False, 0)
        self.disk_details = self._label('No installation disk selected.', 'body', 58)
        left.pack_start(self.disk_details, False, False, 8)
        if not disks:
            left.pack_start(self._label('No eligible blank disk of at least 32 GiB found.', 'danger'), False, False, 0)
        left.pack_start(self._label(
            "Boot media, mounted/in-use disks, and disks with partitions or filesystem signatures are protected. Network access is required. Keep the selected disk connected and the machine powered on.", "body", 58), False, False, 0)
        self.passphrase_title = self._label("Disk unlock and session-lock passphrase", "body-strong")
        right.pack_start(self.passphrase_title, False, False, 0)
        self.passphrase_help = self._label(
            "One passphrase unlocks the encrypted disk and is also the root and clawos account password; approval prompts on this machine ask for it. There is no second login.",
            "body", 58)
        right.pack_start(self.passphrase_help, False, False, 0)
        install_plan = self._classes(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10), "install-plan")
        install_plan.pack_start(self._icon("object-select-symbolic", style="success"), False, False, 0)
        self.install_plan_label = self._label(
            "LUKS2 encryption  ·  Full Root (passwordless sudo)  ·  Recovery TTY on Ctrl+Alt+F3", "body")
        install_plan.pack_start(self.install_plan_label, False, False, 0)
        right.pack_start(install_plan, False, False, 6)
        self.password = Gtk.Entry()
        self.password.set_max_length(128)
        self.password.set_visibility(False)
        self.password.set_placeholder_text("At least 10 characters")
        self.password.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.password.get_accessible().set_name("Disk unlock passphrase")
        self.password.connect("changed", self._validate_passphrase)
        right.pack_start(self.password, False, False, 8)
        self.confirm = Gtk.Entry()
        self.confirm.set_max_length(128)
        self.confirm.set_visibility(False)
        self.confirm.set_placeholder_text("Repeat passphrase")
        self.confirm.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.confirm.get_accessible().set_name("Confirm disk unlock passphrase")
        self.confirm.connect("changed", self._validate_passphrase)
        self.confirm.connect("activate", self.start_install)
        right.pack_start(self.confirm, False, False, 0)
        self.error = self._label("", "danger")
        right.pack_start(self.error, False, False, 0)
        self.passwordless = Gtk.CheckButton()
        self._classes(self.passwordless, 'risk-toggle')
        self.passwordless.add(self._label(
