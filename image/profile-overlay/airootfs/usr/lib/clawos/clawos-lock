#!/usr/bin/env bash
set -euo pipefail

status="$(/usr/bin/timeout 5 /usr/lib/clawos/clawosctl status 2>/dev/null || true)"
[[ -n "$status" ]] || status='{}'
lock_state="$(printf '%s' "$status" | /usr/bin/jq -r '.readiness.lock // "unavailable"')"
if [[ "$lock_state" == disabled ]]; then
  /usr/bin/logger -t clawos-lock 'Screen locking disabled by passwordless development entry policy.'
  exit 0
fi
if [[ "$lock_state" == unavailable ]]; then
  /usr/bin/swaynag \
    --type warning \
    --message 'Device unlock is not configured on this development installation.' \
    --dismiss-button 'Return to ClawOS' \
    --font 'Inter Variable 12' \
    --background 101312 \
    --border ff684f \
    --border-bottom ff684f \
    --text f3f1ee \
    --button-background 202121 \
    --button-text f3f1ee
  exit 1
fi

exec /usr/bin/gtklock --daemonize --config /etc/clawos/gtklock/config.ini
