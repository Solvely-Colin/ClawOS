#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
if [[ ${1:-} == --help ]]; then
  echo 'Usage: boot-smoke-qemu [ISO] (KVM required; CLAWOS_OVMF_CODE, CLAWOS_SMOKE_DEADLINE, CLAWOS_SMOKE_RUNTIME optional)'
  exit 0
fi
(( $# <= 1 )) || { echo 'Expected at most one ISO path' >&2; exit 2; }
[[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || {
  echo 'KVM required: run ./image/tests/boot-smoke-qemu on a Linux host with readable/writable /dev/kvm.' >&2
  exit 1
}
boot_timeout=${CLAWOS_SMOKE_DEADLINE:-180}
[[ $boot_timeout =~ ^[1-9][0-9]{0,3}$ ]] && (( boot_timeout <= 1800 )) || {
  echo 'CLAWOS_SMOKE_DEADLINE must be 1..1800 seconds' >&2; exit 2;
}
iso=${1:-${CLAWOS_SMOKE_ISO:-}}
if [[ -z $iso ]]; then
  shopt -s nullglob
  images=("$repo_root/artifacts/m1/out/"*.iso)
  (( ${#images[@]} == 1 )) || { echo 'Expected exactly one built ISO; pass its path explicitly.' >&2; exit 1; }
  iso=${images[0]}
fi
[[ -f $iso ]] || { echo 'ISO does not exist' >&2; exit 1; }
iso=$(realpath "$iso")

ovmf_code=${CLAWOS_OVMF_CODE:-/usr/share/edk2/x64/OVMF_CODE.4m.fd}
if [[ ! -f "$ovmf_code" ]]; then
  [[ -z ${CLAWOS_OVMF_CODE:-} ]] && ovmf_code=/usr/share/edk2/x64/OVMF_CODE.fd
fi
[[ -f $ovmf_code ]] || { echo 'OVMF firmware missing; set CLAWOS_OVMF_CODE.' >&2; exit 1; }

mkdir -p "$repo_root/artifacts/m1"
if [[ -n ${CLAWOS_SMOKE_RUNTIME:-} ]]; then
  runtime=$CLAWOS_SMOKE_RUNTIME
  mkdir "$runtime" # Refuse to overwrite previous evidence.
else
  runtime="$(mktemp -d "$repo_root/artifacts/m1/smoke.XXXXXX")"
fi
runtime=$(realpath "$runtime")
serial_socket="$runtime/serial.sock"
serial_log="$runtime/serial.log"
transcript="$runtime/transcript.log"
qemu_log="$runtime/qemu.log"
qemu_pid=
qmp_socket="$runtime/qmp.sock"
touch "$serial_log" "$transcript" "$qemu_log"
firmware=(-drive "if=pflash,format=raw,readonly=on,file=$ovmf_code")
ovmf_vars=${CLAWOS_OVMF_VARS:-${ovmf_code/OVMF_CODE/OVMF_VARS}}
if [[ -f $ovmf_vars && $ovmf_vars != "$ovmf_code" ]]; then
  cp "$ovmf_vars" "$runtime/vars.fd"
  firmware+=(-drive "if=pflash,format=raw,file=$runtime/vars.fd")
fi

cleanup() {
  if [[ -n "$qemu_pid" ]] && kill -0 "$qemu_pid" 2>/dev/null; then
    echo 'Requesting ACPI shutdown for the smoke-test guest.' >&2
    python3 "$repo_root/tools/ci/qemu_io.py" powerdown "$qmp_socket" || true
    local stop_deadline=$((SECONDS + 60))
    while kill -0 "$qemu_pid" 2>/dev/null; do
      if (( SECONDS >= stop_deadline )); then
        echo 'Guest did not exit after ACPI; QEMU was NOT terminated. Smoke gate failed.' >&2
        return 1
      fi
      sleep 1
    done
    wait "$qemu_pid" 2>/dev/null || true
  fi
}
finish() {
  local status=$?
  trap - EXIT INT TERM
  cleanup || status=1
  if (( status != 0 )); then
    printf 'Live boot smoke: FAILED\n' >"$runtime/result.txt"
    if "$repo_root/image/tests/scan-log-secrets.sh" "$serial_log" "$transcript" "$qemu_log"; then
      tail -n 60 "$serial_log" "$transcript" "$qemu_log" >&2
    fi
  fi
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

qemu-system-x86_64 \
  -enable-kvm \
  -machine q35,accel=kvm \
  -cpu host \
  -m 4096 \
  -smp 2 \
  "${firmware[@]}" \
  -display none \
  -chardev "socket,id=clawserial,path=$serial_socket,server=on,wait=off,logfile=$serial_log" \
  -serial chardev:clawserial \
  -monitor none \
  -qmp "unix:$qmp_socket,server=on,wait=off" \
  -nic user,model=virtio-net-pci \
  -cdrom "$iso" \
  -boot d \
  -no-reboot >"$qemu_log" 2>&1 &
qemu_pid=$!

deadline=$((SECONDS + boot_timeout))
until [[ -S "$serial_socket" ]] && python3 "$repo_root/tools/ci/qemu_io.py" ready "$serial_log"; do
  if ! kill -0 "$qemu_pid" 2>/dev/null; then
    echo "QEMU exited before the ClawOS serial console became ready." >&2
    exit 1
  fi
  if (( SECONDS >= deadline )); then
    echo "Timed out waiting for the ClawOS serial console." >&2
    exit 1
  fi
  sleep 1
done

# Effective sshd posture as `sshd -T` reports it (case-insensitive keywords), not
# the drop-in text. archiso enables sshd.service on the live medium; wait for
# it briefly because `sshd -T` needs the host keys that exist once it started.
sshd_keyonly_check='for attempt in {1..10}; do systemctl is-active --quiet sshd.service && break; sleep 1; done; '
sshd_keyonly_check+='sshd -T >/tmp/sshd-effective.conf'
sshd_keyonly_check+=' && grep -Fqxi "passwordauthentication no" /tmp/sshd-effective.conf'
sshd_keyonly_check+=' && grep -Fqxi "kbdinteractiveauthentication no" /tmp/sshd-effective.conf'
sshd_keyonly_check+=' && grep -Fqxi "permitrootlogin no" /tmp/sshd-effective.conf'

# The serial console echoes every command it is sent, so a marker spelled out
# in a command would satisfy a plain grep of the transcript. Build the PASS:
# prefix inside the guest; only executed echoes produce it.
commands=$'\nPASS=PASS:\n'
commands+=$'echo "${PASS}__CLAWOS_SMOKE_BEGIN__"\n'
commands+=$'. /etc/os-release; test "$ID" = clawos && echo "${PASS}IDENTITY_OK"\n'
commands+=$'timeout 60 systemctl is-system-running --wait >/tmp/clawos-system-state 2>&1 && test "$(systemctl --failed --no-legend --no-pager)" = "" && echo "${PASS}SYSTEMD_OK"\n'
commands+=$'for attempt in {1..30}; do ip -4 -o address show scope global | grep -q "10.0.2.15/24" && { echo "${PASS}NETWORK_OK"; break; }; sleep 1; done\n'
commands+=$'test "$(findmnt -no FSTYPE /)" = overlay && echo "${PASS}LIVE_ROOT_OK"\n'
commands+="$sshd_keyonly_check"$' && echo "${PASS}SSHD_KEYONLY_OK"\n'
commands+=$'echo "${PASS}__CLAWOS_SMOKE_END__"\n'
commands+=$'poweroff\n'

printf '%s' "$commands" | python3 "$repo_root/tools/ci/qemu_io.py" capture "$serial_socket" "$transcript" 150
tr -d '\r' <"$transcript" >"$runtime/markers.log"

for marker in \
  __CLAWOS_SMOKE_BEGIN__ \
  IDENTITY_OK \
  SYSTEMD_OK \
  NETWORK_OK \
  LIVE_ROOT_OK \
  SSHD_KEYONLY_OK \
  __CLAWOS_SMOKE_END__; do
  if ! grep -Fxq "PASS:$marker" "$runtime/markers.log"; then
    echo "Missing smoke-test marker: $marker" >&2
    exit 1
  fi
done

shutdown_deadline=$((SECONDS + 30))
while kill -0 "$qemu_pid" 2>/dev/null; do
  if (( SECONDS >= shutdown_deadline )); then
    echo "ClawOS passed checks but did not power off cleanly." >&2
    exit 1
  fi
  sleep 1
done
wait "$qemu_pid"
qemu_pid=

# The retained logs are upload candidates; refuse to call the run green while
# any of them carries a secret-shaped string.
"$repo_root/image/tests/scan-log-secrets.sh" "$serial_log" "$transcript" "$qemu_log"
printf 'Live boot smoke: PASS (KVM)\nGraceful shutdown: PASS\nISO SHA256: %s\n' \
  "$(sha256sum "$iso" | cut -d' ' -f1)" >"$runtime/result.txt"

echo "ClawOS headless boot smoke test passed."
echo "Artifacts: $runtime"
