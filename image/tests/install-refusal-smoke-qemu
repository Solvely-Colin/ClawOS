#!/usr/bin/env bash
# Destructive setup is restricted to newly created, disposable QCOW2 images.
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
if [[ ${1:-} == --help ]]; then
  echo 'Usage: install-refusal-smoke-qemu ISO (KVM; new CLAWOS_REFUSAL_RUNTIME optional)'
  exit 0
fi
(( $# == 1 )) && [[ -f $1 ]] || { echo 'Pass one built ISO.' >&2; exit 2; }
[[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || { echo 'Readable/writable KVM required.' >&2; exit 1; }
iso=$(realpath "$1")
ovmf_code=${CLAWOS_OVMF_CODE:-/usr/share/edk2/x64/OVMF_CODE.4m.fd}
if [[ ! -f $ovmf_code && -z ${CLAWOS_OVMF_CODE:-} ]]; then
  ovmf_code=/usr/share/edk2/x64/OVMF_CODE.fd
fi
ovmf_vars=${CLAWOS_OVMF_VARS:-${ovmf_code/OVMF_CODE/OVMF_VARS}}
[[ -f $ovmf_code && -f $ovmf_vars && $ovmf_code != "$ovmf_vars" ]] || {
  echo 'Matching OVMF code and variable templates required.' >&2; exit 1;
}
mkdir -p "$repo_root/artifacts/m1"
if [[ -n ${CLAWOS_REFUSAL_RUNTIME:-} ]]; then
  runtime=$CLAWOS_REFUSAL_RUNTIME
  mkdir "$runtime" # Existing directories/disks are never accepted.
else
  runtime=$(mktemp -d "$repo_root/artifacts/m1/install-refusal.XXXXXX")
fi
runtime=$(realpath "$runtime")
cp "$ovmf_vars" "$runtime/vars.fd"
control_disk="$runtime/control.qcow2"
signature_disk="$runtime/signature.qcow2"
mounted_disk="$runtime/mounted.qcow2"
qemu-img create -f qcow2 "$control_disk" 32G
qemu-img create -f qcow2 "$signature_disk" 36G
qemu-img create -f qcow2 "$mounted_disk" 36G
serial_socket="$runtime/serial.sock"
serial_log="$runtime/serial.log"
transcript="$runtime/transcript.log"
qmp_socket="$runtime/qmp.sock"
qemu_log="$runtime/qemu.log"
touch "$serial_log" "$transcript" "$qemu_log"
qemu_pid=

shutdown_guest() {
  [[ -n $qemu_pid ]] || return 0
  if ! kill -0 "$qemu_pid" 2>/dev/null; then
    wait "$qemu_pid" 2>/dev/null || true
    qemu_pid=
    echo 'QEMU exited before the required ACPI shutdown request.' >&2
    return 1
  fi
  python3 "$repo_root/tools/ci/qemu_io.py" powerdown "$qmp_socket" || return 1
  local deadline=$((SECONDS + 60))
  while kill -0 "$qemu_pid" 2>/dev/null; do
    (( SECONDS < deadline )) || { echo 'ACPI timed out; QEMU was NOT terminated.' >&2; return 1; }
    sleep 1
  done
  wait "$qemu_pid" || return 1
  qemu_pid=
}
finish() {
  local status=$?
  trap - EXIT INT TERM
  shutdown_guest || status=1
  if (( status != 0 )); then
    printf 'Installer refusal smoke: FAILED\n' >"$runtime/result.txt"
    if "$repo_root/image/tests/scan-log-secrets.sh" "$serial_log" "$transcript" "$qemu_log"; then
      echo 'Sanitized refusal transcript tail follows:' >&2
      tail -n 160 "$transcript" >&2
      echo 'Sanitized QEMU log tail follows:' >&2
      tail -n 40 "$qemu_log" >&2
    fi
  fi
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

qemu-system-x86_64 -enable-kvm -machine q35,accel=kvm -cpu host -m 4096 -smp 2 \
  -drive "if=pflash,format=raw,readonly=on,file=$ovmf_code" \
  -drive "if=pflash,format=raw,file=$runtime/vars.fd" \
  -drive "if=none,id=control,format=qcow2,file=$control_disk" \
  -device virtio-blk-pci,drive=control,serial=CLAWOS-REF-CONTROL \
  -drive "if=none,id=signature,format=qcow2,file=$signature_disk" \
  -device virtio-blk-pci,drive=signature,serial=CLAWOS-REF-SIGN \
  -drive "if=none,id=mounted,format=qcow2,file=$mounted_disk" \
  -device virtio-blk-pci,drive=mounted,serial=CLAWOS-REF-MOUNT \
  -device virtio-vga,xres=1440,yres=900 -display none \
  -chardev "socket,id=serial,path=$serial_socket,server=on,wait=off,logfile=$serial_log" \
  -serial chardev:serial -monitor none -qmp "unix:$qmp_socket,server=on,wait=off" \
  -nic user,model=virtio-net-pci -no-reboot -cdrom "$iso" -boot d >"$qemu_log" 2>&1 &
qemu_pid=$!
deadline=$((SECONDS + 240))
until [[ -S $serial_socket ]] && python3 "$repo_root/tools/ci/qemu_io.py" ready "$serial_log" --hostname clawos-live; do
  kill -0 "$qemu_pid" 2>/dev/null || { echo 'QEMU exited before console readiness.' >&2; exit 1; }
  (( SECONDS < deadline )) || { echo 'Console readiness timed out.' >&2; exit 1; }
  sleep 1
done

commands=$(cat <<'COMMANDS'

bash -c '
set -euo pipefail
P=PASS:
echo TRACE:PREPARE_UNSAFE_DISKS
mkdir -p /mnt/clawos-refusal-mounted
printf "label: gpt\ntype=L\n" | sfdisk /dev/vdb >/dev/null
udevadm settle
mkfs.ext4 -q -F /dev/vdb1
mkfs.ext4 -q -F /dev/vdc
mount /dev/vdc /mnt/clawos-refusal-mounted
echo TRACE:UNSAFE_DISKS_READY

boot_device=$(findmnt -nro SOURCE /run/archiso/bootmnt | sed "s/\[.*//")
boot_device=$(readlink -f "$boot_device")
echo "TRACE:BOOT_DEVICE $boot_device"
[[ $boot_device == /dev/* ]]
control_serial=$(cat /sys/block/vda/serial)
signature_serial=$(cat /sys/block/vdb/serial)
mounted_serial=$(cat /sys/block/vdc/serial)
echo "TRACE:SERIALS $control_serial $signature_serial $mounted_serial"
[[ $control_serial == CLAWOS-REF-CONTROL ]]
[[ $signature_serial == CLAWOS-REF-SIGN ]]
[[ $mounted_serial == CLAWOS-REF-MOUNT ]]

inventory=$(python3 /usr/lib/clawos/clawos_install_targets.py list)
echo "TRACE:ELIGIBLE_PATHS $(jq -c "map(.path)" <<<"$inventory")"
jq -e --arg boot "$boot_device" "
  map(.path) as \$paths |
  (\$paths | index(\"/dev/vda\")) != null and
  (\$paths | index(\"/dev/vdb\")) == null and
  (\$paths | index(\"/dev/vdc\")) == null and
  (\$paths | index(\$boot)) == null
" <<<"$inventory" >/dev/null
echo "${P}LIST_EXCLUDES_BOOT_SIGNATURE_MOUNTED"

disk_id() {
  python3 - "$1" <<"PY"
import sys
sys.path.insert(0, "/usr/lib/clawos")
import clawos_install_targets as targets
disks, _boot = targets.inventory()
matches = [disk for disk in disks if disk.get("path") == sys.argv[1]]
if len(matches) != 1:
    raise SystemExit("expected exactly one inventory match")
print(targets.identity(matches[0]))
PY
}

snapshot() {
  local device=$1 output=$2 rc
  mapfile -t nodes < <(lsblk -nrpo NAME "$device")
  {
    printf "DEVICE %s\n" "$device"
    set +e
    sfdisk -d "$device" 2>&1
    rc=$?
    printf "SFDISK_RC %s\n" "$rc"
    blkid "${nodes[@]}" 2>&1
    rc=$?
    printf "BLKID_RC %s\n" "$rc"
    set -e
  } >"$output"
}

refuse_once() {
  local mode=$1 device=$2 id=$3 output=$4 rc
  local args=(--passwordless --target "$device" --disk-id "$id" --confirm "ERASE-$device")
  [[ $mode == dry ]] && args=(--dry-run "${args[@]}")
  set +e
  clawos-install-dev "${args[@]}" >"$output" 2>&1
  rc=$?
  set -e
  (( rc != 0 ))
  ! grep -Fq CLAWOS_INSTALL_DISK_WRITE_STARTED "$output"
  ! grep -Fq "Packages prepared. Beginning" "$output"
  printf "REFUSAL %s %s rc=%s\n" "$mode" "$device" "$rc"
  sed "s/^/REFUSAL_OUTPUT /" "$output"
}

for device in /dev/vdb /dev/vdc "$boot_device"; do
  echo "TRACE:REFUSAL_BEGIN $device"
  safe_name=${device#/dev/}
  id=$(disk_id "$device")
  snapshot "$device" "/tmp/$safe_name.before"
  echo "SNAPSHOT_BEFORE $device $(sha256sum "/tmp/$safe_name.before" | cut -d" " -f1)"
  refuse_once dry "$device" "$id" "/tmp/$safe_name.dry.log"
  snapshot "$device" "/tmp/$safe_name.after-dry"
  cmp "/tmp/$safe_name.before" "/tmp/$safe_name.after-dry"
  echo "${P}DRY_UNCHANGED_$safe_name"
  refuse_once real "$device" "$id" "/tmp/$safe_name.real.log"
  snapshot "$device" "/tmp/$safe_name.after-real"
  cmp "/tmp/$safe_name.before" "/tmp/$safe_name.after-real"
  echo "SNAPSHOT_AFTER $device $(sha256sum "/tmp/$safe_name.after-real" | cut -d" " -f1)"
  echo "${P}REAL_UNCHANGED_$safe_name"
  echo "SNAPSHOT_CONTENT_BEGIN $device"
  cat "/tmp/$safe_name.after-real"
  echo "SNAPSHOT_CONTENT_END $device"
done
echo "${P}ALL_REFUSALS_UNCHANGED"
'
D=DONE:; echo "${D}REFUSALS"
COMMANDS
)
printf '%s\n' "$commands" | python3 "$repo_root/tools/ci/qemu_io.py" capture "$serial_socket" "$transcript" 420 --until DONE:REFUSALS
tr -d '\r' <"$transcript" >"$runtime/markers.log"
for marker in LIST_EXCLUDES_BOOT_SIGNATURE_MOUNTED DRY_UNCHANGED_vdb REAL_UNCHANGED_vdb \
    DRY_UNCHANGED_vdc REAL_UNCHANGED_vdc ALL_REFUSALS_UNCHANGED; do
  grep -Fxq "PASS:$marker" "$runtime/markers.log"
done
grep -Eq '^PASS:DRY_UNCHANGED_sr[0-9]+$' "$runtime/markers.log"
grep -Eq '^PASS:REAL_UNCHANGED_sr[0-9]+$' "$runtime/markers.log"
shutdown_guest
for disk in "$control_disk" "$signature_disk" "$mounted_disk"; do
  qemu-img check "$disk"
done >"$runtime/disk-check.log"
"$repo_root/image/tests/scan-log-secrets.sh" "$serial_log" "$transcript" "$qemu_log" \
  "$runtime/markers.log" "$runtime/disk-check.log"
printf 'Installer refusal smoke: PASS (KVM)\nUnsafe targets: boot medium, GPT/ext4 disk, mounted ext4 disk\nAttempts: dry-run and real; all nonzero before package preparation or disk-write marker\nPartition/signature snapshots: identical before and after each attempt\nGraceful ACPI shutdown: PASS\nISO SHA256: %s\nSource commit: %s\n' \
  "$(sha256sum "$iso" | cut -d' ' -f1)" "${GITHUB_SHA:-unknown}" >"$runtime/result.txt"
echo "Installer refusal smoke passed. Evidence: $runtime"
