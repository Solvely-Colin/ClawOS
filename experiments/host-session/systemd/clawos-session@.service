[Unit]
Description=ClawOS Milestone 0 session for %i
After=systemd-user-sessions.service
Conflicts=getty@tty2.service
After=getty@tty2.service

[Service]
Type=simple
User=%i
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
EnvironmentFile=-/etc/clawos/session.env
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_DESKTOP=clawos
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/usr/lib/clawos/clawos-session
ExecStopPost=+/usr/bin/chvt 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
