# Shared local-state rules: do not rely on a developer's .git/info/exclude.
/.local/
/local-notes/
/docs/local/
*.local.md
# Retired operator/session records; public guidance lives in docs/.
/docs/history/
# Retired layout: preserved notes/cache are under .local/legacy-milestones/.
/m[0-4]/
/shell-prototype/
/experiments/shell-prototype/design-qa.md
/docs/FLIP-DAY.md
/docs/PUBLIC-SOURCE-READINESS.md
/docs/SHARING.md
/docs/assets/HEADER.md
/.claude/
/.codex/worktrees/
/transfer/
/.vscode/
/.idea/
*.swp
*.swo
*~
*.bak

# Generated caches and language/build environments.
.venv/
venv/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
*.tsbuildinfo
*.lcov

