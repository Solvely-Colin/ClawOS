#!/usr/bin/env bash
set -euo pipefail

echo "Installing clean ArchISO host tooling. These packages are build tools;"
echo "they are not copied into the ClawOS image unless listed in packages.x86_64."
sudo pacman --disable-download-timeout --needed --noconfirm -S \
  base-devel \
  git \
  inetutils \
  archiso \
  qemu-desktop \
  edk2-ovmf \
  shellcheck \
  rsync
