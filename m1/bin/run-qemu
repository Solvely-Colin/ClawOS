#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
runtime="$repo_root/artifacts/m1/runtime"
serial_socket="$runtime/serial.sock"
monitor_socket="$runtime/monitor.sock"
serial_log="$runtime/serial.log"
disk_args=()
boot_args=()
disk=
installed=false

while (( $# )); do
  case "$1" in
    --disk)
      disk="${2:-}"
      shift 2
      ;;
    --installed)
      installed=true
      shift
      ;;
    *)
      echo "usage: $0 [--installed] [--disk artifacts/m1/disks/name.qcow2]" >&2
      exit 1
      ;;
  esac
done

if [[ -n "$disk" ]]; then
  disk="$(realpath -e "$disk")"
  disk_root="$(realpath -e "$repo_root/artifacts/m1/disks")"
  if [[ "$disk" != "$disk_root/"*.qcow2 || ! -f "$disk" ]]; then
    echo "Refusing non-qcow2 disk outside $disk_root" >&2
    exit 1
  fi
  if [[ "$(qemu-img info --output=json "$disk" | jq -r .format)" != qcow2 ]]; then
    echo "Refusing disk whose detected format is not qcow2: $disk" >&2
    exit 1
  fi
  disk_args=(-drive "file=$disk,if=virtio,format=qcow2")
  echo "Development disk: $disk"
fi

if $installed; then
  if [[ -z "$disk" ]]; then
    echo "Installed boot requires --disk with a guarded qcow2 image." >&2
    exit 1
  fi
  boot_args=(-boot c)
else
  iso="$(find "$repo_root/artifacts/m1/out" -maxdepth 1 -type f -name '*.iso' -print -quit)"
  if [[ -z "$iso" ]]; then
    echo "No Milestone 1 ISO found. Run sudo ./m1/bin/build-iso first." >&2
    exit 1
  fi
  boot_args=(-cdrom "$iso" -boot d)
fi

ovmf_code=/usr/share/edk2/x64/OVMF_CODE.4m.fd
if [[ ! -f "$ovmf_code" ]]; then
  ovmf_code=/usr/share/edk2/x64/OVMF_CODE.fd
fi
test -f "$ovmf_code"

mkdir -p "$runtime"
rm -f "$serial_socket" "$monitor_socket" "$serial_log"

echo "Serial log: $serial_log"
echo "Console:    $repo_root/m1/bin/qemu-console"
echo "Monitor:    $repo_root/m1/bin/qemu-monitor"

exec qemu-system-x86_64 \
  -enable-kvm \
  -machine q35,accel=kvm \
  -cpu host \
  -m 4096 \
  -smp 4 \
  -drive "if=pflash,format=raw,readonly=on,file=$ovmf_code" \
  -device virtio-vga \
  -display gtk \
  -chardev "socket,id=clawserial,path=$serial_socket,server=on,wait=off,logfile=$serial_log" \
  -serial chardev:clawserial \
  -monitor "unix:$monitor_socket,server=on,wait=off" \
  -nic user,model=virtio-net-pci \
  "${disk_args[@]}" \
  "${boot_args[@]}"
