#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/../.." && pwd)"
source_tool="$repo/m1/profile-overlay/airootfs/usr/lib/clawos/clawos-deploy"
installed_tool=/usr/lib/clawos/clawos-deploy
case "${1:-apply}" in
  stage) exec python3 "$source_tool" stage "$repo" ;;
  status|rollback|check)
    exec sudo "$installed_tool" "$@"
    ;;
  plan|apply)
    action="${1:-apply}"
    shift
    "$repo/m1/bin/preflight-iso"
    payload="$(python3 "$source_tool" stage "$repo")"
    # Initial trusted development bootstrap. Later revisions deploy the updater
    # as a managed file, and each worker runs its own root-owned private copy.
    if [[ ! -f "$installed_tool" ]]; then
      sudo install -m 0755 "$source_tool" "$installed_tool"
    fi
    exec sudo "$installed_tool" "$action" "$payload" "$@"
    ;;
  *) echo "Usage: $0 [plan|apply|stage|status [job]|check|rollback job]" >&2; exit 2 ;;
esac
