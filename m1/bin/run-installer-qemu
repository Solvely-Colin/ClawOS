#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
disk="${1:-$repo_root/artifacts/m1/disks/clawos-dev.qcow2}"

if [[ ! -f "$disk" ]]; then
  echo "Development disk does not exist. Create it first:" >&2
  echo "  $repo_root/m1/bin/create-dev-disk" >&2
  exit 1
fi

exec "$repo_root/m1/bin/run-qemu" --disk "$disk"
