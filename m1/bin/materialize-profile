#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
source "$repo_root/m1/config/versions.env"
destination="${1:-$repo_root/artifacts/m1/profile}"
releng=/usr/share/archiso/configs/releng

if [[ ! -d "$releng" ]]; then
  echo "ArchISO releng profile missing. Run ./m1/bin/install-build-deps first." >&2
  exit 1
fi

if [[ -e "$destination" ]]; then
  echo "Refusing to overwrite existing profile: $destination" >&2
  exit 1
fi

mkdir -p "$(dirname "$destination")"
cp -a "$releng" "$destination"
cp -a "$repo_root/m1/profile-overlay/." "$destination/"
install -m 0644 "$repo_root/m1/config/mirrorlist" \
  "$destination/airootfs/etc/pacman.d/mirrorlist"
install -m 0644 "$repo_root/m1/config/versions.env" \
  "$destination/airootfs/etc/clawos/versions.env"

"$repo_root/m1/tests/no-omarchy.sh" "$destination/airootfs"
echo "Materialized clean profile at $destination"
