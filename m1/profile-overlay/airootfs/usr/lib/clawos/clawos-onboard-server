#!/usr/bin/env node

import { execFile, spawn } from "node:child_process";
import { randomBytes } from "node:crypto";
import { createReadStream, promises as fs } from "node:fs";
import http from "node:http";
import os from "node:os";
import path from "node:path";

const host = "127.0.0.1";
const port = Number.parseInt(process.env.CLAWOS_ONBOARD_PORT || "19401", 10);
const assetRoot = process.env.CLAWOS_ONBOARD_ASSET_ROOT || "/usr/share/clawos/onboarding";
const backgroundPath = process.env.CLAWOS_BACKGROUND_PATH || "/usr/share/clawos/theme/background.png";
const arrowLeftPath = process.env.CLAWOS_ARROW_LEFT_PATH || "/usr/share/clawos/icons/arrow-left.svg";
const configHome = process.env.XDG_CONFIG_HOME || path.join(os.homedir(), ".config");
const policyPath = path.join(configHome, "clawos", "access.json");
const stateHome = process.env.XDG_STATE_HOME || path.join(os.homedir(), ".local", "state");
const checkpointPath = path.join(stateHome, "clawos", "onboarding.json");
const openclawStateDir = process.env.OPENCLAW_STATE_DIR || path.join(os.homedir(), ".openclaw");
const openclawEnvPath = path.join(openclawStateDir, ".env");
let setupRunning = false;
let providerSetup = { running: false, error: null };
const setupStages = ["start", "base", "plugin", "tools", "profile", "machine-policy", "complete"];

const assets = new Map([
  ["/", ["index.html", "text/html; charset=utf-8"]],
  ["/index.html", ["index.html", "text/html; charset=utf-8"]],
  ["/styles.css", ["styles.css", "text/css; charset=utf-8"]],
  ["/app.js", ["app.js", "text/javascript; charset=utf-8"]],
  ["/background.png", [backgroundPath, "image/png"]],
  ["/icons/arrow-left.svg", [arrowLeftPath, "image/svg+xml"]],
]);

function headers(response, contentType = "application/json; charset=utf-8") {
  response.setHeader("content-type", contentType);
  response.setHeader("cache-control", "no-store");
  response.setHeader("x-content-type-options", "nosniff");
  response.setHeader("referrer-policy", "no-referrer");
  response.setHeader(
    "content-security-policy",
    "default-src 'self'; img-src 'self' file:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
  );
}

function json(response, status, body) {
  headers(response);
  response.statusCode = status;
  response.end(JSON.stringify(body));
}

function command(file, args, options = {}) {
  return new Promise((resolve, reject) => {
    execFile(file, args, { timeout: 15_000, maxBuffer: 1024 * 1024, ...options }, (error, stdout, stderr) => {
      if (error) reject(Object.assign(error, { stdout, stderr }));
      else resolve({ stdout, stderr });
    });
  });
}

async function readBody(request) {
  const chunks = [];
  let size = 0;
  for await (const chunk of request) {
    size += chunk.length;
    if (size > 32 * 1024) throw new Error("Request is too large");
    chunks.push(chunk);
  }
  return JSON.parse(Buffer.concat(chunks).toString("utf8"));
}

async function gatewayMode() {
  try {
    const result = await command("/usr/bin/openclaw", ["config", "get", "gateway.mode"]);
    const mode = result.stdout.trim();
    return mode === "local" || mode === "remote" ? mode : null;
  } catch {
    return null;
  }
}

async function selectedModel() {
  try {
    const config = JSON.parse(await fs.readFile(path.join(openclawStateDir, "openclaw.json"), "utf8"));
    const model = config.agents?.defaults?.model;
    return typeof model === "string" ? model : typeof model?.primary === "string" ? model.primary : null;
  } catch { return null; }
}

async function networkOnline() {
  try {
    await command("/usr/bin/nm-online", ["--quiet", "--timeout=1"], { timeout: 2500 });
    return true;
  } catch {
    return false;
  }
}

function validateUrl(value) {
  if (typeof value !== "string" || value.length > 512) return null;
  try {
    const url = new URL(value);
    return url.protocol === "ws:" || url.protocol === "wss:" ? url.toString() : null;
  } catch {
    return null;
  }
}

function validateToken(value, required = true) {
  if (typeof value !== "string") return null;
  const token = value.trim();
  if ((!token && !required) || (token.length >= 12 && token.length <= 512 && /^[A-Za-z0-9._~-]+$/.test(token))) return token;
  return null;
}

async function readOpenClawEnv(name) {
  try {
    const content = await fs.readFile(openclawEnvPath, "utf8");
    const prefix = `${name}=`;
    const line = content.split(/\r?\n/).find((candidate) => candidate.startsWith(prefix));
    return line ? line.slice(prefix.length) : null;
  } catch (error) {
    if (error?.code === "ENOENT") return null;
    throw error;
  }
}

async function saveOpenClawEnv(name, value) {
  if (!/^[A-Z][A-Z0-9_]+$/.test(name) || !/^[A-Za-z0-9._~-]+$/.test(value)) {
    throw new Error("A credential contains unsupported characters.");
  }
  await fs.mkdir(openclawStateDir, { recursive: true, mode: 0o700 });
  let existing = "";
  try {
    existing = await fs.readFile(openclawEnvPath, "utf8");
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
  }
  const lines = existing.split(/\r?\n/).filter((line) => line && !line.startsWith(`${name}=`));
  lines.push(`${name}=${value}`);
  const temporary = `${openclawEnvPath}.${process.pid}.tmp`;
  await fs.writeFile(temporary, `${lines.join("\n")}\n`, { mode: 0o600 });
  await fs.rename(temporary, openclawEnvPath);
}

async function saveAccessPolicy(access) {
  const allowed = new Set(["full-approvals", "full-root", "user-limited"]);
  const selected = allowed.has(access) ? access : "full-root";
  await fs.mkdir(path.dirname(policyPath), { recursive: true, mode: 0o700 });
  const temporary = `${policyPath}.${process.pid}.tmp`;
  await fs.writeFile(temporary, `${JSON.stringify({ version: 1, level: selected }, null, 2)}\n`, { mode: 0o600 });
  await fs.rename(temporary, policyPath);
}

async function readCheckpoint() {
  try {
    const value = JSON.parse(await fs.readFile(checkpointPath, "utf8"));
    if (value?.version !== 1 || !setupStages.includes(value.stage)) return null;
    return value;
  } catch (error) {
    if (error?.code === "ENOENT") return null;
    return null;
  }
}

async function saveCheckpoint(mode, access, stage) {
  if (!setupStages.includes(stage)) throw new Error("Invalid setup checkpoint.");
  await fs.mkdir(path.dirname(checkpointPath), { recursive: true, mode: 0o700 });
  const temporary = `${checkpointPath}.${process.pid}.tmp`;
  const value = { version: 1, mode, access, stage, updatedAt: new Date().toISOString() };
  await fs.writeFile(temporary, `${JSON.stringify(value)}\n`, { mode: 0o600 });
  await fs.rename(temporary, checkpointPath);
}

function stageComplete(checkpoint, mode, access, stage) {
  return checkpoint?.mode === mode && checkpoint?.access === access &&
    setupStages.indexOf(checkpoint.stage) >= setupStages.indexOf(stage);
}

async function applyMachineAccessPolicy(access) {
  const levels = {
    "full-root": "full-root",
    "full-approvals": "full-user-approvals",
    "user-limited": "user-limited",
  };
  const level = levels[access] || "full-root";
  const prepared = await command("/usr/lib/clawos/clawosctl", [
    "prepare", "security.level.configure", JSON.stringify({ level }),
    "{}",
  ], { timeout: 60_000 });
  const request = JSON.parse(prepared.stdout);
  if (!request?.token) throw new Error("The machine security policy could not be prepared.");
  await command("/usr/lib/clawos/clawosctl", ["commit", request.token], { timeout: 660_000 });
}

async function enableClawOSTools(secretEnv) {
  const toolNames = ["clawos_surface", "clawos_activity", "clawos_app", "clawos_system", "browser"];
  const options = { env: { ...process.env, ...secretEnv, NO_COLOR: "1" } };
  let policyKey = "tools.alsoAllow";
  let existing = [];

  // Preserve an operator's explicit policy if setup is run again. OpenClaw
  // rejects allow and alsoAllow in the same scope, so extend whichever form
  // already exists; otherwise add these tools to the active profile.
  try {
    const result = await command("/usr/bin/openclaw", ["config", "get", "tools.allow"], options);
    const configured = JSON.parse(result.stdout);
    if (Array.isArray(configured)) {
      policyKey = "tools.allow";
      existing = configured;
    }
  } catch {
    try {
      const result = await command("/usr/bin/openclaw", ["config", "get", "tools.alsoAllow"], options);
      const configured = JSON.parse(result.stdout);
      if (Array.isArray(configured)) existing = configured;
    } catch {
      // A fresh OpenClaw profile has neither key.
    }
  }

  const merged = [...new Set([...existing, ...toolNames])];
  await command(
    "/usr/bin/openclaw",
    ["config", "set", policyKey, JSON.stringify(merged), "--strict-json"],
    options,
  );
  await command(
    "/usr/bin/openclaw",
    ["config", "set", "browser.enabled", "true", "--strict-json"],
    options,
  );
  await command(
    "/usr/bin/openclaw",
    ["config", "set", "plugins.entries.browser.enabled", "true", "--strict-json"],
    options,
  );
  const browserProfiles = {
    "clawos-browser": { cdpUrl: "http://127.0.0.1:9222", attachOnly: true },
    "clawos-gmail": { cdpUrl: "http://127.0.0.1:9223", attachOnly: true },
    "clawos-outlook": { cdpUrl: "http://127.0.0.1:9224", attachOnly: true },
  };
  await command(
    "/usr/bin/openclaw",
    ["config", "set", "browser.profiles", JSON.stringify(browserProfiles), "--strict-json"],
    options,
  );
  // agent_end is OpenClaw's authoritative completion hook. It is categorized
  // as conversation-capable even though the ClawOS handler deliberately
  // consumes only run id, success, duration, and agent/session metadata.
  await command(
    "/usr/bin/openclaw",
    ["config", "set", "plugins.entries.clawos-system.hooks.allowConversationAccess", "true", "--strict-json"],
    options,
  );
  // ClawOS uses the supported before_prompt_build hook to establish machine
  // embodiment on every turn, including sessions created before installation.
  await command(
    "/usr/bin/openclaw",
    ["config", "set", "plugins.entries.clawos-system.hooks.allowPromptInjection", "true", "--strict-json"],
    options,
  );
}

async function runOnboarding(payload) {
  const mode = payload?.mode;
  const accessLevels = new Set(["full-root", "full-approvals", "user-limited"]);
  const access = accessLevels.has(payload?.access) ? payload.access : "full-root";
  const common = [
    "onboard",
    "--non-interactive",
    "--accept-risk",
    "--flow",
    "quickstart",
    "--skip-ui",
    "--skip-channels",
    "--skip-search",
    "--skip-skills",
    "--suppress-gateway-token-output",
    "--json",
  ];

  let args;
  const secretEnv = {};
  if (mode === "local") {
    if (payload?.apiKey || (payload?.provider && payload.provider !== "skip")) {
      throw new Error("Choose providers and models through OpenClaw setup, not this machine setup endpoint.");
    }
    const savedGatewayToken = validateToken(await readOpenClawEnv("OPENCLAW_GATEWAY_TOKEN"));
    const gatewayToken = savedGatewayToken || randomBytes(32).toString("base64url");
    if (!savedGatewayToken) await saveOpenClawEnv("OPENCLAW_GATEWAY_TOKEN", gatewayToken);
    secretEnv.OPENCLAW_GATEWAY_TOKEN = gatewayToken;
    args = [
      ...common,
      "--mode",
      "local",
      "--gateway-auth",
      "token",
      "--gateway-token-ref-env",
      "OPENCLAW_GATEWAY_TOKEN",
      "--install-daemon",
    ];
    // OpenClaw owns provider discovery, authentication and model selection.
    args.push("--auth-choice", "skip", "--secret-input-mode", "ref");
  } else if (mode === "remote") {
    const remoteUrl = validateUrl(payload?.remoteUrl);
    const remoteToken = validateToken(payload?.remoteToken, false);
    if (!remoteUrl) throw new Error("Enter a ws:// or wss:// Gateway URL.");
    if (remoteToken === null) throw new Error("The Gateway token is not valid.");
    args = [...common, "--mode", "remote", "--skip-daemon", "--remote-url", remoteUrl];
    if (remoteToken) {
      await saveOpenClawEnv("OPENCLAW_GATEWAY_TOKEN", remoteToken);
      secretEnv.OPENCLAW_GATEWAY_TOKEN = remoteToken;
    }
  } else {
    throw new Error("Choose where the Gateway should run.");
  }

  await saveAccessPolicy(access);
  let checkpoint = await readCheckpoint();
  if (checkpoint?.mode !== mode || checkpoint?.access !== access) {
    await saveCheckpoint(mode, access, "start");
    checkpoint = await readCheckpoint();
  }

  // A later integration step may fail after OpenClaw has already committed
  // the role and installed its daemon. Retrying that base phase can make
  // SecretRef-managed credentials look like service environment values, which
  // OpenClaw correctly refuses to persist. Resume from the first incomplete
  // integration step when the requested role is already configured.
  const existingMode = await gatewayMode();
  if (existingMode !== mode && stageComplete(checkpoint, mode, access, "base")) {
    await saveCheckpoint(mode, access, "start");
    checkpoint = await readCheckpoint();
  }
  if (existingMode !== mode) {
    await new Promise((resolve, reject) => {
      const child = spawn("/usr/bin/openclaw", args, {
        stdio: ["ignore", "pipe", "pipe"],
        env: { ...process.env, ...secretEnv, NO_COLOR: "1" },
      });
      let stderr = "";
      // OpenClaw emits a small JSON summary on stdout. Consume it without ever
      // reflecting it into the browser, where credential-bearing fields could
      // otherwise become visible or an unconsumed pipe could stall setup.
      child.stdout.resume();
      child.stderr.on("data", (chunk) => {
        stderr = `${stderr}${chunk}`.slice(-4096);
      });
      child.on("error", reject);
      child.on("exit", (code) => {
        if (code === 0) resolve();
        else reject(new Error(stderr.replace(/[A-Za-z0-9._~-]{24,}/g, "[redacted]").trim() || "OpenClaw setup failed."));
      });
    });
  }
  if (!stageComplete(checkpoint, mode, access, "base")) {
    await saveCheckpoint(mode, access, "base");
    checkpoint = await readCheckpoint();
  }

  // The plugin is required in both roles: the local Gateway loads its tools
  // in Standalone mode, while the node host advertises the typed
  // `clawos.system` command in Node mode. The remote controller must install
  // the same compatible plugin independently.
  if (!stageComplete(checkpoint, mode, access, "plugin")) {
    await command("/usr/bin/openclaw", [
      "plugins", "install", "--link", "/usr/lib/clawos/openclaw-plugin",
      "--force", "--accept-capabilities",
    ], {
      env: { ...process.env, ...secretEnv, NO_COLOR: "1" },
    });
    await saveCheckpoint(mode, access, "plugin");
    checkpoint = await readCheckpoint();
  }
  if (!stageComplete(checkpoint, mode, access, "tools")) {
    if (mode === "local") await enableClawOSTools(secretEnv);
    await saveCheckpoint(mode, access, "tools");
    checkpoint = await readCheckpoint();
  }
  if (!stageComplete(checkpoint, mode, access, "profile")) {
    await command("/usr/lib/clawos/clawos-role", ["profile-save"], {
      env: { ...process.env, ...secretEnv, NO_COLOR: "1" },
    });
    await saveCheckpoint(mode, access, "profile");
    checkpoint = await readCheckpoint();
  }
  if (!stageComplete(checkpoint, mode, access, "machine-policy")) {
    await applyMachineAccessPolicy(access);
    await saveCheckpoint(mode, access, "machine-policy");
  }
  await saveCheckpoint(mode, access, "complete");
}

async function handleApi(request, response, pathname) {
  if (request.method === "GET" && pathname === "/api/provider-status") {
    json(response, 200, {selectedModel: await selectedModel(), providerSetup});
    return;
  }
  if (request.method === "GET" && pathname === "/api/health") {
    json(response, 200, { ok: true });
    return;
  }

  if (request.method === "GET" && pathname === "/api/status") {
    const checkpoint = await readCheckpoint();
    const mode = await gatewayMode();
    json(response, 200, {
      mode,
      network: await networkOnline(),
      running: setupRunning,
      setupComplete: checkpoint?.mode === mode && checkpoint?.stage === "complete",
      stage: checkpoint?.stage || "start",
      access: checkpoint?.access || null,
      selectedModel: await selectedModel(),
      providerSetup,
    });
    return;
  }

  if (request.method === "POST" && pathname === "/api/setup") {
    if (setupRunning || providerSetup.running) {
      json(response, 409, { ok: false, error: "Setup is already running." });
      return;
    }
    setupRunning = true;
    try {
      const payload = await readBody(request);
      await runOnboarding(payload);
      json(response, 200, { ok: true, mode: await gatewayMode() });
    } catch (error) {
      json(response, 400, { ok: false, error: error instanceof Error ? error.message : "Setup failed." });
    } finally {
      setupRunning = false;
    }
    return;
  }

  if (request.method === "POST" && pathname === "/api/provider-setup") {
    if (setupRunning || providerSetup.running || await gatewayMode() !== "local") {
      json(response, 409, {ok: false, error: "Finish local machine setup before opening OpenClaw setup."});
      return;
    }
    providerSetup = {running: true, error: null};
    const child = spawn("/usr/lib/clawos/clawos-provider-setup", [], {stdio: "ignore"});
    child.on("error", () => { providerSetup = {running: false, error: "Could not open OpenClaw setup. Retry from this screen."}; });
    child.on("exit", async code => {
      let error = code === 0 ? null : "OpenClaw setup was closed without completing. Your saved selection is unchanged unless you confirmed a change.";
      if (code === 0) {
        try { await command("/usr/lib/clawos/clawos-role", ["profile-save"]); }
        catch { error = "Model setup closed, but the local role profile could not be saved. Retry before switching roles."; }
      }
      providerSetup = {running: false, error};
    });
    json(response, 202, {ok: true});
    return;
  }

  if (request.method === "POST" && pathname === "/api/finish") {
    const payload = await readBody(request);
    const mode = await gatewayMode();
    const checkpoint = await readCheckpoint();
    if (!mode || checkpoint?.mode !== mode || checkpoint?.stage !== "complete") {
      json(response, 409, { ok: false, error: "Finish setup before entering the Agent workspace." });
      return;
    }
    if (providerSetup.running || (mode === "local" && !await selectedModel() && payload.allowUnconfigured !== true)) {
      json(response, 409, {ok: false, error: "Complete OpenClaw model selection or explicitly choose to configure it later."});
      return;
    }
    json(response, 200, { ok: true });
    setTimeout(() => {
      execFile("/usr/bin/swaymsg", ['[title="^ClawOS Setup$"] kill'], () => {});
    }, 250);
    return;
  }

  json(response, 404, { ok: false, error: "Not found" });
}

const server = http.createServer(async (request, response) => {
  try {
    const requestUrl = new URL(request.url || "/", `http://${host}:${port}`);
    if (requestUrl.pathname.startsWith("/api/")) {
      await handleApi(request, response, requestUrl.pathname);
      return;
    }
    const asset = assets.get(requestUrl.pathname);
    if (!asset || request.method !== "GET") {
      response.statusCode = 404;
      response.end("Not found");
      return;
    }
    const [fileName, contentType] = asset;
    headers(response, contentType);
    createReadStream(fileName.startsWith("/") ? fileName : path.join(assetRoot, fileName)).pipe(response);
  } catch {
    json(response, 500, { ok: false, error: "ClawOS setup encountered an internal error." });
  }
});

server.listen(port, host);
