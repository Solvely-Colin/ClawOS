#!/usr/bin/env bash
set -euo pipefail

gateway_url="${CLAWOS_GATEWAY_URL:-http://127.0.0.1:18789/}"
profile_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clawos/chromium"
mkdir -p "$profile_dir"

exec /usr/lib/chromium/chromium \
  --ozone-platform=wayland \
  --enable-features=UseOzonePlatform \
  --kiosk \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --disable-pinch \
  --user-data-dir="$profile_dir" \
  "$gateway_url"
