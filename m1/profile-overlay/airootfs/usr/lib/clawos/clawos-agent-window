#!/usr/bin/env python3
"""Find/focus the conversation by stable app identity and shell-owned mark."""
import json
import subprocess
import sys
from clawos_windows import AGENT_MARK, find_agent_window


def main():
    action = sys.argv[1] if len(sys.argv) == 2 else "id"
    if action not in {"id", "focus"}:
        raise ValueError("Usage: clawos-agent-window [id|focus]")
    tree = json.loads(subprocess.check_output(["swaymsg", "-t", "get_tree", "-r"], text=True))
    node = find_agent_window(tree)
    if action == "focus":
        commands = f'[con_id="{node["id"]}"] mark --add {AGENT_MARK}'
        result = json.loads(subprocess.check_output(["swaymsg", "-r", commands], text=True))
        if not all(item.get("success") for item in result):
            raise ValueError("Could not mark the Agent window")
        commands = f'[con_id="{node["id"]}"] focus'
        result = json.loads(subprocess.check_output(["swaymsg", "-r", commands], text=True))
        if not all(item.get("success") for item in result):
            raise ValueError("Could not focus the Agent window")
    print(node["id"])


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
