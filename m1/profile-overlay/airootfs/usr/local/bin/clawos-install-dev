#!/usr/bin/env bash
set -euo pipefail

source /etc/clawos/versions.env

target=
confirmation=
key_file=
disk_id=
dry_run=false
vm_test=false

while (( $# )); do
  case "$1" in
    --list) exec python3 /usr/lib/clawos/clawos_install_targets.py list ;;
    --disk-id) disk_id="${2:-}"; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --vm-test) vm_test=true; shift ;;
    --target)
      target="${2:-}"
      shift 2
      ;;
    --confirm)
      confirmation="${2:-}"
      shift 2
      ;;
    --key-file)
      key_file="${2:-}"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

[[ $EUID == 0 ]] || { echo 'Run installer validation through sudo or the live installer.' >&2; exit 1; }
exec 9>/run/clawos-installer.lock
flock -n 9 || { echo 'Another installation is already running.' >&2; exit 1; }
if $vm_test; then
  [[ "$(systemd-detect-virt --vm)" == kvm && "$target" == /dev/vda &&
     "$(cat /sys/class/dmi/id/product_name)" == 'Standard PC (Q35 + ICH9, 2009)' ]] || {
    echo 'Serial root autologin is restricted to the explicit Q35 VM test harness.' >&2; exit 1;
  }
fi
plan=$(python3 /usr/lib/clawos/clawos_install_targets.py validate \
  --target "$target" --disk-id "$disk_id" --confirm "$confirmation")
if $dry_run; then printf '%s\n' "$plan"; exit 0; fi
if [[ ! "$key_file" =~ ^/run/user/[0-9]+/clawos-install\.key$ || ! -f "$key_file" || -L "$key_file" ]]; then
  echo "The LUKS key must be the installer-owned regular file in a live user's runtime directory." >&2
  exit 1
fi
if [[ ! "$(stat -c %a "$key_file")" =~ ^(400|600)$ ]]; then
  echo "The LUKS key file must have mode 0600 or stricter." >&2
  exit 1
fi
private_key=$(mktemp /run/clawos-install-key.XXXXXX)
trap 'rm -f -- "$private_key"' EXIT
python3 - "$key_file" "$private_key" <<'PY'
import os, pathlib, stat, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != int(pathlib.Path(sys.argv[1]).parent.name) or info.st_nlink != 1:
        raise SystemExit('Installer key ownership or file type is invalid')
    if stat.S_IMODE(info.st_mode) not in (0o400, 0o600):
        raise SystemExit('Installer key permissions changed')
    secret = os.read(fd, 513)
    if not 10 <= len(secret) <= 512 or any(c in secret for c in (b'\0', b'\n', b'\r')):
        raise SystemExit('Use a single-line passphrase of 10 to 512 bytes')
    pathlib.Path(sys.argv[2]).write_bytes(secret)
finally:
    os.close(fd)
PY
key_file=$private_key
# Fail before erasing if the required online sources are not reachable.
curl --fail --silent --show-error --location --head --max-time 20 \
  "https://archive.archlinux.org/repos/$ARCH_SNAPSHOT/core/os/x86_64/core.db" >/dev/null
curl --fail --silent --show-error --head --max-time 20 \
  "https://registry.npmjs.org/openclaw/$OPENCLAW_VERSION" >/dev/null

# The caller should use a restrictive umask when creating the LUKS key, but
# that setting must not leak into the target filesystem. Arch package directory
# modes assume the conventional system umask.
umask 022

esp=$(printf '%s' "$plan" | jq -r .esp)
system_partition=$(printf '%s' "$plan" | jq -r .systemPartition)
mapper=clawos-root
[[ ! -e /dev/mapper/$mapper ]] || { echo 'Existing ClawOS mapper is in use; refusing installation.' >&2; exit 1; }
mount_root=$(mktemp -d /mnt/clawos-install.XXXXXX)
mounted=false
opened=false

cleanup() {
  local status=0
  if $mounted; then
    if umount -R "$mount_root"; then mounted=false; else status=1; fi
  fi
  if ! $mounted && $opened; then
    if cryptsetup close "$mapper"; then opened=false; else status=1; fi
  fi
  rm -f -- "$private_key"
  if ! $mounted; then rmdir "$mount_root" 2>/dev/null || true; fi
  return "$status"
}
trap cleanup EXIT INT TERM

echo "Installing experimental network-backed ClawOS to $target."
echo "This is not the offline production installer."

# Recheck the same disk and live-media protections immediately before the first
# destructive command. Hotplug or state changes invalidate the selection.
python3 /usr/lib/clawos/clawos_install_targets.py validate \
  --target "$target" --disk-id "$disk_id" --confirm "$confirmation" >/dev/null

sfdisk --wipe always "$target" <<'EOF'
label: gpt
size=1G, type=U
type=L
EOF
# sfdisk already asks the kernel to reload the table. A second BLKRRPART can
# legitimately return EBUSY while udev is opening the freshly announced
# partitions, so the proof condition is the partition devices themselves.
blockdev --rereadpt "$target" 2>/dev/null || true
udevadm settle
if [[ ! -b "$esp" || ! -b "$system_partition" ]]; then
  echo "Kernel did not expose the expected EFI and system partitions." >&2
  exit 1
fi

python3 /usr/lib/clawos/clawos_install_targets.py check-identity --target "$target" --disk-id "$disk_id"
mkfs.fat -F 32 -n CLAWOS_EFI "$esp"
python3 /usr/lib/clawos/clawos_install_targets.py check-identity --target "$target" --disk-id "$disk_id"
cryptsetup luksFormat --batch-mode --type luks2 --label CLAWOS_CRYPT \
  --key-file "$key_file" "$system_partition"
cryptsetup open --key-file "$key_file" "$system_partition" "$mapper"
opened=true

mkfs.btrfs -f -L CLAWOS_ROOT "/dev/mapper/$mapper"
mount "/dev/mapper/$mapper" "$mount_root"
for subvolume in @ @home @var_log @pkg @snapshots; do
  btrfs subvolume create "$mount_root/$subvolume"
done
umount "$mount_root"

mount -o subvol=@,compress=zstd,noatime "/dev/mapper/$mapper" "$mount_root"
mounted=true
mkdir -p "$mount_root"/{boot,home,var/log,var/cache/pacman/pkg,.snapshots}
mount -o subvol=@home,compress=zstd,noatime "/dev/mapper/$mapper" "$mount_root/home"
mount -o subvol=@var_log,compress=zstd,noatime "/dev/mapper/$mapper" "$mount_root/var/log"
mount -o subvol=@pkg,compress=zstd,noatime "/dev/mapper/$mapper" "$mount_root/var/cache/pacman/pkg"
mount -o subvol=@snapshots,compress=zstd,noatime "/dev/mapper/$mapper" "$mount_root/.snapshots"
mount "$esp" "$mount_root/boot"

pacstrap -K "$mount_root" \
  base linux linux-firmware intel-ucode amd-ucode btrfs-progs cryptsetup dosfstools \
  networkmanager openssh sudo zsh tmux curl jq \
  chromium foot fuzzel sway swaybg waybar swayidle mesa noto-fonts inter-font otf-geist-mono-nerd \
  gtklock gtklock-userinfo-module gtk-layer-shell python-gobject orca \
  nodejs npm polkit lxqt-policykit plymouth tailscale

arch-chroot "$mount_root" env \
  npm_config_audit=false \
  npm_config_fund=false \
  npm install --global \
    --allow-scripts='openclaw,@google/genai,tree-sitter-bash,protobufjs' \
    "openclaw@$OPENCLAW_VERSION"
arch-chroot "$mount_root" openclaw --version | grep -Fq "$OPENCLAW_VERSION"

genfstab -U "$mount_root" >"$mount_root/etc/fstab"
printf 'clawos-installed\n' >"$mount_root/etc/hostname"
cat >"$mount_root/etc/os-release" <<'EOF'
NAME="ClawOS"
PRETTY_NAME="ClawOS Milestone 1 Installed Proof"
ID=clawos
ID_LIKE=arch
BUILD_ID=development
ANSI_COLOR="38;2;255;92;53"
IMAGE_ID=clawos
IMAGE_VERSION=2026.08.26
EOF

sed -i 's|^root:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*$|root:x:0:0:root:/root:/usr/bin/zsh|' \
  "$mount_root/etc/passwd"

arch-chroot "$mount_root" groupadd --system clawos-control
arch-chroot "$mount_root" useradd --create-home --comment 'ClawOS' --groups video,input,clawos-control --shell /usr/bin/zsh clawos
arch-chroot "$mount_root" useradd --system --create-home --home-dir /var/lib/clawos/agent-home \
  --comment 'ClawOS agent runtime' --groups clawos-control --shell /usr/bin/zsh claw
# One secret owns the physical device for this proof: it unlocks the encrypted
# disk at boot and authenticates an explicit GTK session lock later. Passing it
# through stdin keeps it out of arguments, environment variables, and logs.
passwd --root "$mount_root" --stdin root <"$key_file" >/dev/null
passwd --root "$mount_root" --stdin clawos <"$key_file" >/dev/null
arch-chroot "$mount_root" runuser -u clawos -- openclaw --version | \
  grep -Fq "$OPENCLAW_VERSION"
install -d -m 0755 "$mount_root/var/lib/systemd/linger"
touch "$mount_root/var/lib/systemd/linger/clawos"
touch "$mount_root/var/lib/systemd/linger/claw"
install -d -m 2770 "$mount_root/srv/clawos/shared"
arch-chroot "$mount_root" chown clawos:clawos-control /srv/clawos/shared

install -d -m 0755 \
  "$mount_root/etc/clawos" \
  "$mount_root/etc/xdg" \
  "$mount_root/etc/plymouth" \
  "$mount_root/usr/lib/clawos" \
  "$mount_root/usr/lib/tmpfiles.d" \
  "$mount_root/usr/share/applications" \
  "$mount_root/usr/share/clawos" \
  "$mount_root/usr/share/plymouth/themes/clawos" \
  "$mount_root/etc/systemd/system"
cp -a /etc/clawos/. "$mount_root/etc/clawos/"
cp -a /etc/xdg/. "$mount_root/etc/xdg/"
cp -a /etc/plymouth/. "$mount_root/etc/plymouth/"
install -d -m 0750 "$mount_root/etc/sudoers.d"
install -m 0440 /etc/clawos/full-root.sudoers \
  "$mount_root/etc/sudoers.d/90-clawos-full-root"
cp -a /usr/lib/clawos/. "$mount_root/usr/lib/clawos/"
install -m 0644 /usr/lib/tmpfiles.d/clawos-control.conf \
  "$mount_root/usr/lib/tmpfiles.d/clawos-control.conf"
cp -a /usr/share/applications/clawos-browser.desktop \
  "$mount_root/usr/share/applications/clawos-browser.desktop"
cp -a /usr/share/applications/clawos-agent.desktop \
  /usr/share/applications/clawos-terminal.desktop \
  /usr/share/applications/clawos-browser-surface.desktop \
  /usr/share/applications/clawos-gmail.desktop \
  /usr/share/applications/clawos-outlook.desktop \
  "$mount_root/usr/share/applications/"
cp -a /usr/share/clawos/. "$mount_root/usr/share/clawos/"
cp -a /usr/share/plymouth/themes/clawos/. \
  "$mount_root/usr/share/plymouth/themes/clawos/"
install -m 0644 /etc/systemd/system/clawos-session@.service \
  "$mount_root/etc/systemd/system/clawos-session@.service"
install -m 0644 /etc/systemd/system/clawosd.service \
  "$mount_root/etc/systemd/system/clawosd.service"
install -d -m 0755 \
  "$mount_root/etc/dbus-1/system.d" \
  "$mount_root/usr/share/dbus-1/system-services" \
  "$mount_root/usr/share/dbus-1/interfaces" \
  "$mount_root/usr/share/polkit-1/actions"
install -m 0644 /etc/dbus-1/system.d/org.clawos.System.conf \
  "$mount_root/etc/dbus-1/system.d/org.clawos.System.conf"
install -m 0644 /usr/share/dbus-1/system-services/org.clawos.System.service \
  "$mount_root/usr/share/dbus-1/system-services/org.clawos.System.service"
install -m 0644 /usr/share/dbus-1/interfaces/org.clawos.System.xml \
  "$mount_root/usr/share/dbus-1/interfaces/org.clawos.System.xml"
install -m 0644 /usr/share/polkit-1/actions/org.clawos.system.policy \
  "$mount_root/usr/share/polkit-1/actions/org.clawos.system.policy"
chmod 0755 "$mount_root/usr/lib/clawos/clawos-session" \
  "$mount_root/usr/lib/clawos/clawos-browser" \
  "$mount_root/usr/lib/clawos/clawos-entry" \
  "$mount_root/usr/lib/clawos/clawos-onboard" \
  "$mount_root/usr/lib/clawos/clawos-onboard-ui" \
  "$mount_root/usr/lib/clawos/clawos-onboard-server" \
  "$mount_root/usr/lib/clawos/clawos-install-node" \
  "$mount_root/usr/lib/clawos/clawos-enroll-local-node" \
  "$mount_root/usr/lib/clawos/clawos-gateway-watchdog" \
  "$mount_root/usr/lib/clawos/clawos-panel" \
  "$mount_root/usr/lib/clawos/clawos-panel-status" \
  "$mount_root/usr/lib/clawos/clawos-clock-status" \
  "$mount_root/usr/lib/clawos/clawos-activity-status" \
  "$mount_root/usr/lib/clawos/clawos-activity-action" \
  "$mount_root/usr/lib/clawos/clawos-actions-menu" \
  "$mount_root/usr/lib/clawos/clawos-agent-panel" \
  "$mount_root/usr/lib/clawos/clawos-agent-panel-status" \
  "$mount_root/usr/lib/clawos/clawos-agent-shelf" \
  "$mount_root/usr/lib/clawos/clawos-agent-submit" \
  "$mount_root/usr/lib/clawos/clawos-agent-run" \
  "$mount_root/usr/lib/clawos/clawos-agent-request" \
  "$mount_root/usr/lib/clawos/clawos-agent-recover" \
  "$mount_root/usr/lib/clawos/clawos-approval" \
  "$mount_root/usr/lib/clawos/clawosctl" \
  "$mount_root/usr/lib/clawos/clawos-screen-reader-toggle" \
  "$mount_root/usr/lib/clawos/clawos-attention-status" \
  "$mount_root/usr/lib/clawos/clawos-surface" \
  "$mount_root/usr/lib/clawos/clawos-surfaced" \
  "$mount_root/usr/lib/clawos/clawos-appctl" \
  "$mount_root/usr/lib/clawos/clawos-app-from-fuzzel" \
  "$mount_root/usr/lib/clawos/clawos-intent-palette" \
  "$mount_root/usr/lib/clawos/clawos-app-palette" \
  "$mount_root/usr/lib/clawos/clawos-webapp" \
  "$mount_root/usr/lib/clawos/clawos-return-to-setup" \
  "$mount_root/usr/lib/clawos/clawos-role" \
  "$mount_root/usr/lib/clawos/clawos-security-mode" \
  "$mount_root/usr/lib/clawos/clawos-lock" \
  "$mount_root/usr/lib/clawos/clawos-power-menu" \
  "$mount_root/usr/lib/clawos/clawos-system-menu" \
  "$mount_root/usr/lib/clawos/clawos-power-action" \
  "$mount_root/usr/lib/clawos/clawos-command" \
  "$mount_root/usr/lib/clawos/clawos-build" \
  "$mount_root/usr/lib/clawos/clawos-build-activity" \
  "$mount_root/usr/lib/clawos/clawos-refresh-agent-ui" \
  "$mount_root/usr/lib/clawos/clawos-browse" \
  "$mount_root/usr/lib/clawos/clawos-open-url"

install -m 0644 /etc/clawos/zshrc "$mount_root/home/clawos/.zshrc"
chown 1000:1000 "$mount_root/home/clawos/.zshrc"

if $vm_test; then
  mkdir -p "$mount_root/etc/systemd/system/serial-getty@ttyS0.service.d"
  cat >"$mount_root/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --noreset --noclear --autologin root 115200,57600,38400,9600 - $TERM
EOF
fi

cat >"$mount_root/etc/mkinitcpio.conf.d/clawos.conf" <<'EOF'
HOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block plymouth sd-encrypt filesystems fsck)
EOF

arch-chroot "$mount_root" systemctl enable \
  NetworkManager.service sshd.service tailscaled.service \
  clawosd.service clawos-session@clawos.service
arch-chroot "$mount_root" systemctl mask getty@tty2.service
arch-chroot "$mount_root" mkinitcpio -P
if $vm_test; then
  arch-chroot "$mount_root" bootctl --esp-path=/boot --variables=no install
else
  arch-chroot "$mount_root" bootctl --esp-path=/boot install
fi

crypt_uuid="$(cryptsetup luksUUID "$system_partition")"
mkdir -p "$mount_root/boot/loader/entries"
cat >"$mount_root/boot/loader/loader.conf" <<'EOF'
default clawos.conf
timeout 1
console-mode keep
editor no
EOF
cat >"$mount_root/boot/loader/entries/clawos.conf" <<EOF
title ClawOS
linux /vmlinuz-linux
initrd /initramfs-linux.img
options rd.luks.name=$crypt_uuid=$mapper root=/dev/mapper/$mapper rootflags=subvol=@ rw quiet splash loglevel=3 rd.systemd.show_status=auto vt.global_cursor_default=0 plymouth.ignore-serial-consoles console=tty0 console=ttyS0,115200n8
EOF

sync
cleanup
mounted=false
opened=false
trap - EXIT INT TERM

echo "CLAWOS_INSTALL_DEV_OK"
