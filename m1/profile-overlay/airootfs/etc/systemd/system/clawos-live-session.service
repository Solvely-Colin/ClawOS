[Unit]
Description=ClawOS graphical live environment
After=systemd-user-sessions.service systemd-tmpfiles-setup.service
Conflicts=getty@tty2.service
After=getty@tty2.service

[Service]
Type=simple
User=clawos-live
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_DESKTOP=clawos-live
Environment=NO_AT_BRIDGE=0
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/usr/lib/clawos/clawos-live-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
