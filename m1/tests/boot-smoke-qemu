#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
iso="$(find "$repo_root/artifacts/m1/out" -maxdepth 1 -type f -name '*.iso' -print -quit)"
test -n "$iso"

ovmf_code=/usr/share/edk2/x64/OVMF_CODE.4m.fd
if [[ ! -f "$ovmf_code" ]]; then
  ovmf_code=/usr/share/edk2/x64/OVMF_CODE.fd
fi
test -f "$ovmf_code"

mkdir -p "$repo_root/artifacts/m1"
runtime="$(mktemp -d "$repo_root/artifacts/m1/smoke.XXXXXX")"
serial_socket="$runtime/serial.sock"
serial_log="$runtime/serial.log"
transcript="$runtime/transcript.log"
qemu_log="$runtime/qemu.log"
qemu_pid=

cleanup() {
  if [[ -n "$qemu_pid" ]] && kill -0 "$qemu_pid" 2>/dev/null; then
    kill "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

qemu-system-x86_64 \
  -enable-kvm \
  -machine q35,accel=kvm \
  -cpu host \
  -m 2048 \
  -smp 2 \
  -drive "if=pflash,format=raw,readonly=on,file=$ovmf_code" \
  -display none \
  -chardev "socket,id=clawserial,path=$serial_socket,server=on,wait=off,logfile=$serial_log" \
  -serial chardev:clawserial \
  -monitor none \
  -nic user,model=virtio-net-pci \
  -cdrom "$iso" \
  -boot d \
  -no-reboot >"$qemu_log" 2>&1 &
qemu_pid=$!

deadline=$((SECONDS + 90))
until [[ -S "$serial_socket" ]] && grep -Fq 'clawos-live#' "$serial_log" 2>/dev/null; do
  if ! kill -0 "$qemu_pid" 2>/dev/null; then
    echo "QEMU exited before the ClawOS serial console became ready." >&2
    tail -n 80 "$serial_log" >&2 || true
    exit 1
  fi
  if (( SECONDS >= deadline )); then
    echo "Timed out waiting for the ClawOS serial console." >&2
    tail -n 80 "$serial_log" >&2 || true
    exit 1
  fi
  sleep 1
done

commands=$'\n'
commands+=$'echo __CLAWOS_SMOKE_BEGIN__\n'
commands+=$'. /etc/os-release; test "$ID" = clawos && echo IDENTITY_OK\n'
commands+=$'test "$(systemctl --failed --no-legend --no-pager)" = "" && echo SYSTEMD_OK\n'
commands+=$'for attempt in {1..30}; do ip -4 -brief address show enp0s1 | grep -q "10.0.2.15/24" && { echo NETWORK_OK; break; }; sleep 1; done\n'
commands+=$'test "$(findmnt -no FSTYPE /)" = overlay && echo LIVE_ROOT_OK\n'
commands+=$'echo __CLAWOS_SMOKE_END__\n'
commands+=$'poweroff\n'

{
  sleep 1
  printf '%s' "$commands"
  sleep 40
} | timeout 60 socat - "UNIX-CONNECT:$serial_socket" >"$transcript" 2>&1 || true

for marker in \
  __CLAWOS_SMOKE_BEGIN__ \
  IDENTITY_OK \
  SYSTEMD_OK \
  NETWORK_OK \
  LIVE_ROOT_OK \
  __CLAWOS_SMOKE_END__; do
  if ! grep -Fq "$marker" "$transcript"; then
    echo "Missing smoke-test marker: $marker" >&2
    tail -n 120 "$transcript" >&2 || true
    exit 1
  fi
done

shutdown_deadline=$((SECONDS + 30))
while kill -0 "$qemu_pid" 2>/dev/null; do
  if (( SECONDS >= shutdown_deadline )); then
    echo "ClawOS passed checks but did not power off cleanly." >&2
    exit 1
  fi
  sleep 1
done
wait "$qemu_pid"
qemu_pid=

echo "ClawOS headless boot smoke test passed."
echo "Artifacts: $runtime"
