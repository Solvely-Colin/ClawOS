#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
iso="$(find "$repo_root/artifacts/m1/out" -maxdepth 1 -type f -name '*.iso' -print -quit)"
test -n "$iso"

ovmf_code=/usr/share/edk2/x64/OVMF_CODE.4m.fd
if [[ ! -f "$ovmf_code" ]]; then
  ovmf_code=/usr/share/edk2/x64/OVMF_CODE.fd
fi
test -f "$ovmf_code"

resume_runtime="${CLAWOS_M2_RESUME_RUNTIME:-}"
if [[ -n "$resume_runtime" ]]; then
  runtime="$(realpath "$resume_runtime")"
  test -d "$runtime"
else
  runtime="$(mktemp -d "$repo_root/artifacts/m1/m2-e2e.XXXXXX")"
fi
disk="$runtime/clawos-m2.qcow2"
test_secret='clawos-m2-test-only'
qemu_pid=

cleanup() {
  if [[ -n "$qemu_pid" ]] && kill -0 "$qemu_pid" 2>/dev/null; then
    kill "$qemu_pid" 2>/dev/null || true
    wait "$qemu_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if [[ -z "$resume_runtime" ]]; then
  qemu-img create -q -f qcow2 "$disk" 32G
else
  qemu-img info "$disk" >/dev/null
fi

start_guest() {
  local phase="$1"
  shift
  serial_socket="$runtime/$phase-serial.sock"
  monitor_socket="$runtime/$phase-monitor.sock"
  serial_log="$runtime/$phase-serial.log"
  qemu_log="$runtime/$phase-qemu.log"
  rm -f "$serial_socket" "$monitor_socket"

  qemu-system-x86_64 \
    -enable-kvm \
    -machine q35,accel=kvm \
    -cpu host \
    -m 4096 \
    -smp 4 \
    -drive "if=pflash,format=raw,readonly=on,file=$ovmf_code" \
    -device virtio-vga,xres=1440,yres=900 \
    -display none \
    -chardev "socket,id=clawserial,path=$serial_socket,server=on,wait=off,logfile=$serial_log" \
    -serial chardev:clawserial \
    -monitor "unix:$monitor_socket,server=on,wait=off" \
    -nic user,model=virtio-net-pci \
    -drive "file=$disk,if=virtio,format=qcow2" \
    "$@" \
    -no-reboot >"$qemu_log" 2>&1 &
  qemu_pid=$!
}

wait_log() {
  local pattern="$1"
  local timeout_seconds="$2"
  local deadline=$((SECONDS + timeout_seconds))
  until grep -Fq "$pattern" "$serial_log" 2>/dev/null; do
    if ! kill -0 "$qemu_pid" 2>/dev/null; then
      echo "QEMU exited while waiting for: $pattern" >&2
      tail -n 120 "$serial_log" >&2 || true
      return 1
    fi
    if (( SECONDS >= deadline )); then
      echo "Timed out waiting for: $pattern" >&2
      tail -n 120 "$serial_log" >&2 || true
      return 1
    fi
    sleep 1
  done
}

send_serial() {
  local payload="$1"
  # QEMU's emulated UART has a small receive FIFO. Pushing a multi-kilobyte
  # shell program into the socket at host speed can silently drop bytes, so
  # pace bounded chunks like an actual serial sender.
  {
    while [[ -n "$payload" ]]; do
      printf '%s' "${payload:0:64}"
      payload="${payload:64}"
      sleep 0.02
    done
  } | socat - "UNIX-CONNECT:$serial_socket" >/dev/null
}

send_monitor() {
  printf '%s\n' "$1" | socat - "UNIX-CONNECT:$monitor_socket" >/dev/null
}

send_key_text() {
  local text="$1"
  local character key
  while IFS= read -r -n1 character; do
    case "$character" in
      -) key=minus ;;
      [a-z0-9]) key="$character" ;;
      *)
        echo "Unsupported QEMU test-key character: $character" >&2
        return 1
        ;;
    esac
    send_monitor "sendkey $key"
  done < <(printf '%s' "$text")
  send_monitor 'sendkey ret'
}

capture_screen() {
  local name="$1"
  local ppm="$runtime/$name.ppm"
  local mean=0
  local attempt

  # Firmware hands the framebuffer to Plymouth asynchronously. A fixed sleep
  # can catch the valid, encrypted-root boot during that black transition, so
  # retain the first materially rendered frame for deterministic evidence.
  for attempt in {1..60}; do
    rm -f "$ppm"
    printf 'screendump %s\n' "$ppm" | socat - "UNIX-CONNECT:$monitor_socket" >/dev/null
    for _ in {1..10}; do
      [[ -s "$ppm" ]] && break
      sleep 0.1
    done
    if [[ -s "$ppm" ]]; then
      if command -v magick >/dev/null 2>&1; then
        magick "$ppm" "$runtime/$name.png"
        mean="$(magick "$runtime/$name.png" -colorspace gray -format '%[fx:mean]' info:)"
      else
        convert "$ppm" "$runtime/$name.png"
        mean="$(identify -format '%[fx:mean]' "$runtime/$name.png")"
      fi
      if identify "$runtime/$name.png" | grep -Fq '1440x900' \
        && awk -v mean="$mean" 'BEGIN { exit !(mean > 0.005) }'; then
        rm -f "$ppm"
        return 0
      fi
    fi
    sleep 1
  done

  rm -f "$ppm"
  echo "No materially rendered 1440x900 frame appeared: $runtime/$name.png" >&2
  return 1
}

wait_poweroff() {
  local deadline=$((SECONDS + 60))
  while kill -0 "$qemu_pid" 2>/dev/null; do
    if (( SECONDS >= deadline )); then
      echo "Guest did not power off cleanly." >&2
      return 1
    fi
    sleep 1
  done
  wait "$qemu_pid"
  qemu_pid=
}

if [[ -z "$resume_runtime" ]]; then
echo "Booting the fresh M2 live image."
start_guest live -cdrom "$iso" -boot d
wait_log 'clawos-live#' 120
send_serial $'stty -echo\n'
sleep 1
live_checks=$'\nPASS=PASS:\n'
live_checks+=$'echo "${PASS}__M2_LIVE_BEGIN__"\n'
live_checks+=$'for attempt in {1..30}; do systemctl is-active --quiet clawos-live-session.service && { echo "${PASS}GRAPHICAL_LIVE_OK"; break; }; sleep 1; done\n'
live_checks+=$'id clawos-live >/dev/null && echo "${PASS}LIVE_USER_OK"\n'
live_checks+=$'test -e /dev/tty3 && echo "${PASS}RECOVERY_TTY_OK"\n'
live_checks+=$'live_uid=$(id -u clawos-live)\n'
live_checks+=$'for attempt in {1..60}; do live_sock=$(find "/run/user/$live_uid" -maxdepth 1 -type s -name "sway-ipc.*.sock" -print -quit 2>/dev/null); if test -n "$live_sock" && SWAYSOCK="$live_sock" swaymsg -t get_tree | grep -Fq "ClawOS Setup"; then echo "${PASS}LIVE_WINDOW_OK"; break; fi; sleep 1; done\n'
live_checks+=$'echo "${PASS}__M2_LIVE_END__"\n'
send_serial "$live_checks"
wait_log 'PASS:__M2_LIVE_END__' 100
for marker in GRAPHICAL_LIVE_OK LIVE_USER_OK RECOVERY_TTY_OK LIVE_WINDOW_OK; do
  grep -Fq "PASS:$marker" "$serial_log"
done
capture_screen live-welcome

echo "Running the same guarded installer exposed by the graphical flow."
install_commands=$'install -d -m 0700 /run/user/0\n'
install_commands+="printf '%s' '$test_secret' > /run/user/0/clawos-install.key"$'\n'
install_commands+=$'chmod 0600 /run/user/0/clawos-install.key\n'
install_commands+=$'clawos-install-dev --target /dev/vda --confirm ERASE-QEMU-/dev/vda --key-file /run/user/0/clawos-install.key\n'
install_commands+=$'install_result=$?; rm -f /run/user/0/clawos-install.key; echo __M2_INSTALL_STATUS_${install_result}__; poweroff\n'
send_serial "$install_commands"
wait_log '__M2_INSTALL_STATUS_0__' 1800
wait_poweroff
else
  echo "Resuming installed-system validation from: $runtime"
fi

echo "Booting the installed encrypted system with the ISO detached."
start_guest installed -boot c
# Plymouth owns the graphical encrypted-root prompt and intentionally keeps it
# off the serial recovery console. Wait for initramfs/systemd to own the boot,
# retain visual evidence of the unlock surface, then type through QEMU's virtual
# keyboard exactly as a person at the machine would.
wait_log 'comm=systemd;type=boot' 120
sleep 8
capture_screen installed-unlock
send_key_text "$test_secret"
wait_log 'clawos-installed#' 180
send_serial $'stty -echo\n'
sleep 1
if [[ "${CLAWOS_M2_DIAGNOSTIC:-0}" == 1 ]]; then
  echo "Installed diagnostic guest is ready: $runtime"
  while kill -0 "$qemu_pid" 2>/dev/null; do sleep 1; done
  wait "$qemu_pid"
  exit 0
fi
installed_commands=$'\nPASS=PASS:\n'
installed_commands+=$'echo "${PASS}__M2_INSTALLED_BEGIN__"\n'
installed_commands+=$'test "$(systemctl --failed --no-legend --no-pager)" = "" && echo "${PASS}INSTALLED_SYSTEMD_OK"\n'
installed_commands+=$'for attempt in {1..60}; do systemctl is-active --quiet clawos-session@clawos.service && { echo "${PASS}AGENT_SESSION_OK"; break; }; sleep 1; done\n'
installed_commands+=$'installed_uid=$(id -u clawos)\n'
installed_commands+=$'for attempt in {1..90}; do installed_sock=$(find "/run/user/$installed_uid" -maxdepth 1 -type s -name "sway-ipc.*.sock" -print -quit 2>/dev/null); if test -n "$installed_sock" && SWAYSOCK="$installed_sock" swaymsg -t get_tree | grep -Eq "ClawOS Setup|OpenClaw Control"; then echo "${PASS}AGENT_CANVAS_RENDERED_OK"; break; fi; sleep 1; done\n'
installed_commands+=$'test -x /usr/lib/clawos/clawos-agent-shelf && echo "${PASS}SHELF_IMAGE_BUILT_OK"\n'
installed_commands+="test -f /etc/clawos/waybar/config.jsonc && grep -Eq '\"height\"[[:space:]]*:[[:space:]]*52' /etc/clawos/waybar/config.jsonc && echo \"\${PASS}TOP_BAR_IMAGE_BUILT_OK\""$'\n'
installed_commands+=$'test -f /usr/share/clawos/onboarding/index.html && echo "${PASS}ONBOARDING_IMAGE_BUILT_OK"\n'
installed_commands+=$'test -e /dev/tty3 && echo "${PASS}INSTALLED_RECOVERY_OK"\n'
installed_commands+=$'systemctl is-active --quiet clawosd.service && echo "${PASS}CLAWOSD_SERVICE_OK"\n'
installed_commands+=$'test -x /usr/lib/clawos/clawosctl && test -x /usr/lib/clawos/clawos-approval && echo "${PASS}CLAWOSD_CLIENT_UI_OK"\n'
installed_commands+="/usr/lib/clawos/clawosctl status | grep -Fq '\"securityLevel\":\"full-root\"' && echo \"\${PASS}CLAWOSD_STATUS_OK\""$'\n'
installed_commands+=$'id claw >/dev/null && id -nG claw | grep -qw clawos-control && echo "${PASS}USER_LIMITED_IDENTITY_OK"\n'
installed_commands+=$'test -d /srv/clawos/shared && test "$(stat -c %G /srv/clawos/shared)" = clawos-control && echo "${PASS}EXPLICIT_SHARE_OK"\n'
installed_commands+=$'runuser -u clawos -- /usr/bin/openclaw agents add reviewer --workspace /home/clawos/.openclaw/workspace-reviewer --non-interactive --json >/tmp/m2-agent-add.json\n'
installed_commands+=$'runuser -u clawos -- /usr/bin/openclaw agents bind --agent reviewer --bind "telegram:*" --json >/tmp/m2-agent-bind.json\n'
installed_commands+=$'runuser -u clawos -- /usr/bin/openclaw agents list --bindings --json >/tmp/m2-agents.json\n'
installed_commands+="jq -e 'map(.id) | index(\"main\") and index(\"reviewer\")' /tmp/m2-agents.json >/dev/null && echo \"\${PASS}MULTI_AGENT_CREATED_OK\""$'\n'
installed_commands+="jq -e 'map(select(.id == \"reviewer\"))[0] | .bindings == 1 and (.bindingDetails | index(\"telegram accountId=*\"))' /tmp/m2-agents.json >/dev/null && echo \"\${PASS}MULTI_AGENT_ROUTED_OK\""$'\n'
installed_commands+="main_workspace=\$(jq -r 'map(select(.id == \"main\"))[0].workspace' /tmp/m2-agents.json); reviewer_workspace=\$(jq -r 'map(select(.id == \"reviewer\"))[0].workspace' /tmp/m2-agents.json); runuser -u clawos -- mkdir -p \"\$main_workspace\" \"\$reviewer_workspace\"; test \"\$main_workspace\" != \"\$reviewer_workspace\" && test -d \"\$main_workspace\" && test -d \"\$reviewer_workspace\" && echo \"\${PASS}MULTI_AGENT_ISOLATION_OK\""$'\n'
installed_commands+=$'echo "${PASS}__M2_INSTALLED_END__"\n'
send_serial "$installed_commands"
wait_log 'PASS:__M2_INSTALLED_END__' 120
for marker in \
  INSTALLED_SYSTEMD_OK \
  AGENT_SESSION_OK \
  AGENT_CANVAS_RENDERED_OK \
  SHELF_IMAGE_BUILT_OK \
  TOP_BAR_IMAGE_BUILT_OK \
  ONBOARDING_IMAGE_BUILT_OK \
  INSTALLED_RECOVERY_OK \
  CLAWOSD_SERVICE_OK \
  CLAWOSD_CLIENT_UI_OK \
  CLAWOSD_STATUS_OK \
  USER_LIMITED_IDENTITY_OK \
  EXPLICIT_SHARE_OK \
  MULTI_AGENT_CREATED_OK \
  MULTI_AGENT_ROUTED_OK \
  MULTI_AGENT_ISOLATION_OK; do
  grep -Fq "PASS:$marker" "$serial_log"
done
sleep 8
capture_screen installed-first-boot

echo "Preparing and approving the M3 typed package-install proof."
m3_commands="$(cat <<'M3_PREPARE'
PASS=PASS:
m3_security=$(/usr/lib/clawos/clawosctl prepare security.level.configure '{"level":"full-user-approvals"}')
m3_security_token=$(echo "$m3_security" | jq -r .token)
/usr/lib/clawos/clawosctl commit "$m3_security_token" >/tmp/m3-security-result.json
test "$(jq -r .state /tmp/m3-security-result.json)" = complete && test "$(jq -r .securityLevel /tmp/m3-security-result.json)" = full-user-approvals && test ! -e /etc/sudoers.d/90-clawos-full-root && echo "${PASS}M3_APPROVAL_MODE_OK"
m3_parameters=$(/usr/bin/jq -cn --arg package tree '{package:$package}')
m3_prepared=$(runuser -u clawos -- /usr/lib/clawos/clawosctl prepare package.install "$m3_parameters")
m3_token=$(echo "$m3_prepared" | jq -r .token)
m3_snapshot_expected=$(echo "$m3_prepared" | jq -r .actionId | sed 's/^/clawosd-/')
test "$(echo "$m3_prepared" | jq -r .requester.attribution)" = unavailable && echo "${PASS}M3_PREPARE_OK"
runuser -u clawos -- env SWAYSOCK="$installed_sock" /usr/bin/swaymsg exec /usr/lib/clawos/clawos-approval >/dev/null
echo "${PASS}__M3_APPROVAL_READY__"
M3_PREPARE
)"$'\n'
send_serial "$m3_commands"
wait_log 'PASS:__M3_APPROVAL_READY__' 30
for _ in {1..30}; do
  if grep -Fq 'PASS:M3_PREPARE_OK' "$serial_log"; then break; fi
  sleep 1
done
grep -Fq 'PASS:M3_PREPARE_OK' "$serial_log"
grep -Fq 'PASS:M3_APPROVAL_MODE_OK' "$serial_log"
sleep 5
capture_screen m3-approval

m3_commit="$(cat <<'M3_COMMIT'
m3_result=$(/usr/lib/clawos/clawosctl commit "$m3_token")
test "$(echo "$m3_result" | jq -r .state)" = complete && echo "${PASS}M3_COMMIT_OK"
pacman -Q tree >/dev/null && echo "${PASS}M3_PACKAGE_OK"
test -d "/.snapshots/$m3_snapshot_expected" && echo "${PASS}M3_SNAPSHOT_OK"
grep -Fq '"event":"completed"' /var/log/clawos/audit.jsonl && echo "${PASS}M3_AUDIT_OK"
m3_security_ok=1
if grep -Fq "$m3_token" /var/log/clawos/audit.jsonl; then m3_security_ok=0; else echo "${PASS}M3_AUDIT_TOKEN_SAFE_OK"; fi
if /usr/lib/clawos/clawosctl commit "$m3_token" >/dev/null 2>&1; then m3_security_ok=0; else echo "${PASS}M3_TOKEN_SINGLE_USE_OK"; fi
test "$m3_security_ok" = 1 && echo "${PASS}M3_SECURITY_OK"
echo "${PASS}__M3_COMMIT_END__"
M3_COMMIT
)"$'\n'
send_serial "$m3_commit"
wait_log 'PASS:__M3_COMMIT_END__' 300
for marker in M3_COMMIT_OK M3_PACKAGE_OK M3_SNAPSHOT_OK M3_AUDIT_OK M3_AUDIT_TOKEN_SAFE_OK M3_TOKEN_SINGLE_USE_OK M3_SECURITY_OK; do
  grep -Fq "PASS:$marker" "$serial_log"
done

echo "Preparing the separately approved installed-root rollback proof."
m3_rollback_prepare="$(cat <<'M3_ROLLBACK_PREPARE'
m3_rollback=$(/usr/lib/clawos/clawosctl prepare recovery.rollback "{\"snapshotId\":\"$m3_snapshot_expected\"}")
m3_rollback_token=$(echo "$m3_rollback" | jq -r .token)
test "$(echo "$m3_rollback" | jq -r .requiresApproval)" = true && echo "${PASS}M3_ROLLBACK_PREPARE_OK"
runuser -u clawos -- env SWAYSOCK="$installed_sock" /usr/bin/swaymsg exec /usr/lib/clawos/clawos-approval >/dev/null
echo "${PASS}__M3_ROLLBACK_APPROVAL_READY__"
M3_ROLLBACK_PREPARE
)"$'\n'
send_serial "$m3_rollback_prepare"
wait_log 'PASS:__M3_ROLLBACK_APPROVAL_READY__' 30
grep -Fq 'PASS:M3_ROLLBACK_PREPARE_OK' "$serial_log"
sleep 5
capture_screen m3-rollback-approval
m3_rollback_commit=$'m3_rollback_result=$(/usr/lib/clawos/clawosctl commit "$m3_rollback_token")\n'
m3_rollback_commit+=$'test "$(echo "$m3_rollback_result" | jq -r .state)" = complete && test "$(echo "$m3_rollback_result" | jq -r .rebootRequired)" = true && echo "${PASS}M3_ROLLBACK_STAGED_OK"\n'
m3_rollback_commit+=$'echo "${PASS}__M3_ROLLBACK_COMMIT_END__"\n'
send_serial "$m3_rollback_commit"
wait_log 'PASS:__M3_ROLLBACK_COMMIT_END__' 120
grep -Fq 'PASS:M3_ROLLBACK_STAGED_OK' "$serial_log"
send_serial $'poweroff\n'
wait_poweroff

echo "Booting the restored root to prove rollback, recovery retention, and graphical continuity."
start_guest rollback -boot c
wait_log 'comm=systemd;type=boot' 120
sleep 8
send_key_text "$test_secret"
wait_log 'clawos-installed#' 180
send_serial $'stty -echo\n'
rollback_checks=$'PASS=PASS:\n'
rollback_checks+=$'echo "${PASS}__M3_ROLLBACK_BOOT_BEGIN__"\n'
rollback_checks+=$'if pacman -Q tree >/dev/null 2>&1; then false; else echo "${PASS}M3_ROLLBACK_PACKAGE_REVERSED_OK"; fi\n'
rollback_checks+="rollback_source=\$(findmnt -n -o SOURCE / | sed 's/\\[.*//'); install -d -m 0700 /run/clawosd/btrfs-top; mount -t btrfs -o subvolid=5 \"\$rollback_source\" /run/clawosd/btrfs-top"$'\n'
rollback_checks+=$'find /run/clawosd/btrfs-top -maxdepth 1 -type d -name "@failed-*" -print -quit | grep -q . && echo "${PASS}M3_FAILED_ROOT_RETAINED_OK"\n'
rollback_checks+=$'umount /run/clawosd/btrfs-top\n'
rollback_checks+=$'for attempt in {1..60}; do systemctl is-active --quiet clawos-session@clawos.service && { echo "${PASS}M3_ROLLBACK_GRAPHICAL_OK"; break; }; sleep 1; done\n'
rollback_checks+=$'echo "${PASS}__M3_ROLLBACK_BOOT_END__"\n'
send_serial "$rollback_checks"
wait_log 'PASS:__M3_ROLLBACK_BOOT_END__' 120
for marker in M3_ROLLBACK_PACKAGE_REVERSED_OK M3_FAILED_ROOT_RETAINED_OK M3_ROLLBACK_GRAPHICAL_OK; do
  grep -Fq "PASS:$marker" "$serial_log"
done
capture_screen m3-rollback-boot
send_serial $'poweroff\n'
wait_poweroff

echo "ClawOS M2 fresh live-to-installed QEMU validation passed."
echo "Evidence: $runtime"
